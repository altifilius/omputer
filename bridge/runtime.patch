+import { afterEach, beforeEach, expect, test, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Agent, type AgentMessage } from "@oh-my-pi/pi-agent-core";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { getBundledModel } from "@oh-my-pi/pi-catalog/models";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { pageRpcMessages } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-messages";
+import { RpcSessionEventForwarder } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-session-events";
+import type { RpcProjectedSessionEventFrame } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-types";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { makeAssistantMessage } from "./session-manager/helpers";
+
+let directory: string;
+let auth: AuthStorage;
+const sessions: AgentSession[] = [];
+const frames: RpcProjectedSessionEventFrame[] = [];
+
+beforeEach(async () => {
+	directory = await fs.mkdtemp(path.join(os.tmpdir(), "omputer-message-identities-"));
+	auth = await AuthStorage.create(":memory:");
+	auth.keys.setRuntime("anthropic", "test-key");
+	frames.length = 0;
+});
+afterEach(async () => {
+	for (const session of sessions.splice(0)) await session.dispose();
+	auth.close();
+	await fs.rm(directory, { recursive: true, force: true });
+	vi.restoreAllMocks();
+});
+
+function host(manager: SessionManager): AgentSession {
+	const mock = createMockModel({ handler: { content: ["reply"] } });
+	const session = new AgentSession({
+		agent: new Agent({
+			initialState: { model: getBundledModel("anthropic", "claude-sonnet-4-5")!, systemPrompt: ["Test"], tools: [] },
+			getApiKey: () => "test-key", streamFn: mock.stream, convertToLlm,
+		}),
+		sessionManager: manager,
+		settings: Settings.isolated({ "compaction.enabled": false, "retry.enabled": false, "todo.enabled": false }),
+		modelRegistry: new ModelRegistry(auth, undefined, { ignoreLocalModelConfig: true }),
+	});
+	session.enableOmputerMessageIds();
+	const forwarder = new RpcSessionEventForwarder(frame => frames.push(JSON.parse(JSON.stringify(frame))), message => session.getOmputerMessageId(message));
+	session.subscribe(event => forwarder.forward(event));
+	sessions.push(session);
+	return session;
+}
+
+test("same-millisecond users, including identical repeats, retain their real journal ids through stream, pages, fork and restart", async () => {
+	const manager = SessionManager.create(directory, path.join(directory, "sessions"));
+	const session = host(manager);
+	const timestamp = 1792329478325;
+	for (const text of ["Queued owned remove", "Queued owned edit", "same", "same"]) {
+		const message: AgentMessage = { role: "user", content: [{ type: "text", text }], timestamp };
+		session.agent.emitExternalEvent({ type: "message_start", message });
+		session.agent.emitExternalEvent({ type: "message_end", message });
+	}
+	const partial = { ...makeAssistantMessage(), timestamp, content: [] };
+	const update = { ...partial, content: [{ type: "text" as const, text: "stream" }] };
+	const completed = { ...update, content: [{ type: "text" as const, text: "stream complete" }] };
+	session.agent.emitExternalEvent({ type: "message_start", message: partial });
+	session.agent.emitExternalEvent({ type: "message_update", message: update,
+		assistantMessageEvent: { type: "text_delta", contentIndex: 0, delta: "stream", partial: update } });
+	session.agent.emitExternalEvent({ type: "message_end", message: completed });
+	await session.settleInFlightMessagePersistence();
+	await manager.ensureOnDisk();
+	await manager.flush();
+
+	const visible = session.getOmputerMessages();
+	expect(visible).toHaveLength(5);
+	const ids = visible.map(message => message._entryId);
+	expect(new Set(ids).size).toBe(5);
+	const live = frames.filter(frame => frame.type === "message_start" || frame.type === "message_update" || frame.type === "message_end");
+	expect(live.map(frame => frame.messageId)).toEqual([ids[0], ids[0], ids[1], ids[1], ids[2], ids[2], ids[3], ids[3], ids[4], ids[4], ids[4]]);
+	expect(session.messages.every(message => !("_entryId" in message) && !("messageId" in message))).toBe(true);
+
+	const snapshot = { sessionId: manager.getSessionId(), leafId: manager.getLeafId(), messageCount: visible.length };
+	const pageOne = pageRpcMessages(visible, snapshot, { limit: 2 });
+	const pageTwo = pageRpcMessages(visible, snapshot, { limit: 2, cursor: pageOne.nextCursor });
+	const pageThree = pageRpcMessages(visible, snapshot, { limit: 2, cursor: pageTwo.nextCursor });
+	expect([...pageOne.messages, ...pageTwo.messages, ...pageThree.messages].map(message => message._entryId)).toEqual(ids);
+
+	manager.appendCompaction("provider context summary", undefined, ids[4], 100);
+	expect(session.getOmputerMessages().map(message => message._entryId)).toEqual(ids);
+	manager.createBranchedSession(manager.getLeafId()!);
+	expect(session.getOmputerMessages().map(message => message._entryId)).toEqual(ids);
+	const forkFile = manager.getSessionFile()!;
+	const forkId = manager.getSessionId();
+	await session.dispose();
+	sessions.splice(sessions.indexOf(session), 1);
+	const resumed = host(await SessionManager.open(forkFile));
+	expect(resumed.sessionManager.getSessionId()).toBe(forkId);
+	expect(resumed.getOmputerMessages().map(message => message._entryId)).toEqual(ids);
+	const replay: RpcProjectedSessionEventFrame[] = [];
+	const reconnect = new RpcSessionEventForwarder(frame => replay.push(frame), message => resumed.getOmputerMessageId(message));
+	for (const entry of resumed.sessionManager.getBranch()) if (entry.type === "message") reconnect.forward({ type: "message_end", message: entry.message });
+	expect(replay.map(frame => "messageId" in frame ? frame.messageId : undefined)).toEqual(ids);
+});
+
+test("older journals without host metadata preserve authoritative entry ids and compacted history", async () => {
+	const source = path.join(directory, "legacy.jsonl");
+	const timestamp = 1792329478325;
+	await fs.writeFile(source, [
+		{ type: "session", version: 3, id: "legacy-journal", cwd: directory, timestamp: new Date(timestamp).toISOString() },
+		...(["67072843", "0f87e894"] as const).map((id, index) => ({ type: "message", id, parentId: index === 0 ? null : "67072843", timestamp: new Date(timestamp).toISOString(), message: { role: "user", content: [{ type: "text", text: "identical" }], timestamp } })),
+		{ type: "compaction", id: "compacted", parentId: "0f87e894", timestamp: new Date(timestamp).toISOString(), summary: "old", firstKeptEntryId: "0f87e894", tokensBefore: 100 },
+	].map(entry => JSON.stringify(entry)).join("\n") + "\n");
+	const session = host(await SessionManager.open(source));
+	expect(session.getOmputerMessages().map(message => message._entryId)).toEqual(["67072843", "0f87e894"]);
+	expect(session.getOmputerMessages().map(message => "content" in message ? message.content : undefined)).toEqual([
+		[{ type: "text", text: "identical" }], [{ type: "text", text: "identical" }],
+	]);
+});
+
+test("real follow-up delivery stores identical same-millisecond queue items separately", async () => {
+	const manager = SessionManager.create(directory, path.join(directory, "sessions"));
+	const session = host(manager);
+	const clock = vi.spyOn(Date, "now").mockReturnValue(1792329478325);
+	try {
+		await session.followUp("repeat queued request");
+		await session.followUp("repeat queued request");
+	} finally {
+		clock.mockRestore();
+	}
+	await session.prompt("drain the queue");
+	await session.waitForIdle();
+	await session.settleInFlightMessagePersistence();
+	const repeated = session.getOmputerMessages().filter(message => message.role === "user" && JSON.stringify(message.content).includes("repeat queued request"));
+	expect(repeated).toHaveLength(2);
+	expect(repeated[0].timestamp).toBe(repeated[1].timestamp);
+	expect(repeated[0]._entryId).not.toBe(repeated[1]._entryId);
+	await manager.ensureOnDisk();
+	await manager.flush();
+	const source = manager.getSessionFile()!;
+	await session.dispose();
+	sessions.splice(sessions.indexOf(session), 1);
+	const resumed = host(await SessionManager.open(source));
+	expect(resumed.getOmputerMessages().filter(message => message.role === "user" && JSON.stringify(message.content).includes("repeat queued request")).map(message => message._entryId)).toEqual(repeated.map(message => message._entryId));
+});
