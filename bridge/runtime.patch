+import * as fs from "node:fs";
+import * as path from "node:path";
+import { createHash } from "node:crypto";
+import * as vcs from "@oh-my-pi/pi-natives/vcs";
+import { KEYBINDINGS } from "@oh-my-pi/pi-tui/app-keybindings";
+import { getKeybindings, type Keybinding } from "@oh-my-pi/pi-tui/keybindings";
+import { extractLastCodeBlock, extractLastCommand, extractLastLink } from "@oh-my-pi/pi-tui/overlays/copy-targets";
+import { openCloexecSync } from "@oh-my-pi/pi-utils/fs-open";
+import type { TextContent } from "@oh-my-pi/pi-ai";
+import type { TaskParams, TaskToolDetails } from "@oh-my-pi/pi-tui/tools/task";
+import { listLocalFiles, resolveLocalRoot } from "../internal-urls/local-protocol";
+import { isBundledSeance, resolveSeanceSource } from "../task/seance";
+import { SEANCE_AGENT_NAME } from "../task/seance-policy";
+import seanceCommandPrompt from "../prompts/system/seance-command.md" with { type: "text" };
+import seanceCommandSolutionSpace from "../prompts/system/seance-command-solution-space.md" with { type: "text" };
+import type { ExtensionContext } from "../extensibility/extensions/types";
+import { MCPManager } from "../mcp/manager";
+import { AgentRegistry } from "../registry/agent-registry";
+import { discoverAgents } from "../task/discovery";
+import { parseCommandArgs } from "../utils/command-args";
+import type { AgentSession } from "./agent-session";
+import type { OmputerCommand } from "./omputer-controls";
+import { getOmputerHost } from "./omputer-host";
+
+type Json = Record<string, unknown>;
+type Args = string | Json;
+export interface OmputerLocalSnapshot { journalId: string; source: string | null; root: string; }
+export type OmputerPhoneAction =
+	| { kind: "clipboard"; text: string; target: "code" | "command" | "link"; language?: string }
+	| { kind: "open_url"; url: string };
+export interface OmputerParentResult extends OmputerLocalSnapshot {
+	status: "requires_parent";
+	action?: OmputerPhoneAction;
+	hostAction?: "close" | "restart";
+	requestRestart?: boolean;
+}
+
+function fail(message: string, code = "invalid_arguments"): never {
+	throw Object.assign(new Error(message), { code });
+}
+function fields(args: Json, allowed: readonly string[]): void {
+	if (Object.keys(args).some(key => !allowed.includes(key))) fail("Unknown local command argument");
+}
+function text(args: Json, key: string): string {
+	const value = args[key];
+	if (typeof value !== "string" || !value.trim()) fail(`${key} is required`);
+	return value;
+}
+function parse(name: string, raw: Args): Json {
+	if (typeof raw !== "string") {
+		if (!raw || typeof raw !== "object" || Array.isArray(raw)) fail("Local command arguments must be a string or object");
+		return { ...raw };
+	}
+	const tokens = parseCommandArgs(raw, { strict: true });
+	if (name === "local") {
+		if (!tokens.length) return { action: "edit" };
+		const action = ["list", "read", "edit"].includes(tokens[0]!) ? tokens.shift()! : "edit";
+		if (action === "list") { if (tokens.length) fail("Usage: /local list"); return { action }; }
+		if (tokens.length !== 1) fail("Usage: /local [read|edit] <name>");
+		return { action, name: tokens[0] };
+	}
+	if (name === "seance") {
+		const args: Json = {};
+		for (let index = 0; index < tokens.length; index++) {
+			const token = tokens[index]!;
+			if (token === "--model" || token.startsWith("--model=")) {
+				if (args.model !== undefined) fail("Use --model only once");
+				const model = token === "--model" ? tokens[++index] : token.slice(8);
+				if (!model || model.startsWith("-")) fail("An explicit model selector is required after --model");
+				args.model = model;
+			} else {
+				if (token.startsWith("-") || args.source !== undefined) fail("Usage: /seance [session id|path] [--model selector]");
+				args.source = token;
+			}
+		}
+		return args;
+	}
+	if (name === "copy") {
+		if (tokens.length !== 1) fail("Usage: /copy code|command|link");
+		const target = tokens[0] === "cmd" ? "command" : tokens[0] === "url" ? "link" : tokens[0];
+		return { target };
+	}
+	if (name === "record" || name === "live") {
+		if (tokens.length > 1) fail(`Usage: /${name} <action>`);
+		return { action: tokens[0] ?? "status" };
+	}
+	if (name === "git") {
+		const action = tokens.shift() ?? "status";
+		if (action === "stage" || action === "unstage") {
+			if (!tokens.length) fail("Specify exact repository-relative paths");
+			return { action, files: tokens };
+		}
+		if (action === "commit") {
+			if (tokens.length !== 1) fail("Usage: /git commit \"commit message\"");
+			return { action, message: tokens[0] };
+		}
+		if (action === "diff") {
+			const cached = tokens[0] === "--cached";
+			if (cached) tokens.shift();
+			return { action, cached, files: tokens };
+		}
+		if (action !== "status" || tokens.length) fail("Usage: /git status|diff|stage|unstage|commit");
+		return { action };
+	}
+	if (tokens.length) fail(`/${name} does not accept arguments`);
+	return {};
+}
+
+/** Local-only command core. The bridge must retain its identity/revision/confirmation fence. */
+export class OmputerLocal {
+	#recording: { fd: number; file: string; journalId: string; unsubscribe: () => void; events: number } | undefined;
+	#recordError: string | undefined;
+	constructor(readonly session: AgentSession, readonly ctx: ExtensionContext) {
+		session.addDisposer(() => this.dispose());
+	}
+
+	snapshot(): OmputerLocalSnapshot {
+		return { journalId: this.session.sessionManager.getSessionId(), source: this.session.sessionManager.getSessionFile() ?? null, root: this.session.sessionManager.getCwd() };
+	}
+
+	isRead(name: string, raw: Args = {}): boolean {
+		const command = this.commands().find(command => command.name === name || command.aliases.includes(name));
+		if (!command) fail("Unknown local command", "unknown_command");
+		name = command.name;
+		const args = parse(name, raw);
+		if (["extensions", "agents", "hotkeys", "debug"].includes(name)) {
+			fields(args, []);
+			return true;
+		}
+		if (name === "record" || name === "live") {
+			fields(args, ["action"]);
+			return (args.action ?? "status") === "status";
+		}
+		if (name === "local") {
+			fields(args, ["action", "name"]);
+			return args.action === "list" || args.action === "read";
+		}
+		if (name === "git") {
+			const action = args.action ?? "status";
+			if (action === "status") { fields(args, ["action"]); return true; }
+			if (action === "diff") { fields(args, ["action", "files", "cached"]); return true; }
+		}
+		return false;
+	}
+
+	/** Terminal owner only: call after the final response was delivered and acknowledged. */
+	acknowledgeShutdown(expected: OmputerLocalSnapshot): void {
+		this.#assertIdentity(expected);
+		this.ctx.shutdown();
+	}
+
+	commands(): OmputerCommand[] {
+		const definitions: Array<[string, string[], string, OmputerCommand["risk"], boolean, string?]> = [
+			["clear", ["reset"], "Clear model context while retaining the session journal", "destructive", true],
+			["delete", [], "Delete this session and retain a valid replacement session", "destructive", true],
+			["quit", ["q", "exit"], "Close the owning host after the response is delivered", "destructive", true],
+			["restart", [], "Restart the owning managed host, resuming this journal", "execute", true],
+			["extensions", ["status"], "Loaded extension and MCP connection state", "read", false],
+			["agents", ["hub"], "Owned agent registry and available agent definitions", "read", false, "agents"],
+			["hotkeys", [], "Terminal keybindings and phone control help", "read", false],
+			["debug", [], "Credential-free session runtime state", "read", false],
+			["copy", [], "Copy the last code block, command, or link on the phone", "change", false, "clipboard"],
+			["open", [], "Open the last assistant link on the phone", "change", false, "open_url"],
+			["git", [], "Local Git status, diff, stage, unstage, and commit", "execute", true],
+			["record", [], "Record conversation events as private JSONL (not terminal pixels)", "change", false],
+			["live", [], "Control the owning PC microphone realtime voice session", "provider", false],
+			["local", [], "List, read, or edit this session's local:// text artifacts", "change", true],
+			["seance", [], "Consult a saved session using the bundled seance agent", "provider", true],
+		];
+		return definitions.map(([name, aliases, description, risk, requiresIdle, localAction]) => ({
+			id: `builtin:${name}`, name, aliases, description, risk, requiresIdle, localAction,
+			source: "builtin", available: true, subcommands: name === "local"
+				? [{ name: "list" }, { name: "read", usage: "<name>" }, { name: "edit", usage: "[name]" }]
+				: name === "seance" ? [{ name: "--model", usage: "<selector>" }] : [],
+		}));
+	}
+
+	async query(view: string, args: Json = {}): Promise<Json> {
+		if (!args || typeof args !== "object" || Array.isArray(args)) fail("Query arguments must be an object");
+		fields(args, []);
+		if (view === "status") view = "extensions";
+		if (view === "hub") view = "agents";
+		if (view === "extensions") {
+			const runner = this.session.extensionRunner;
+			const manager = MCPManager.instance();
+			// Worker threads expose MCPManagerApi, not the owning connection manager.
+			const owner = manager instanceof MCPManager ? manager : undefined;
