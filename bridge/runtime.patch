+import { expect, test } from "bun:test";
+import { dispatchRpcControlFrame, requestRpcAskDialog, type PendingExtensionRequest, type RpcInputFrameDeps } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-mode";
+
+test("an acknowledged answer settles the actual ask once and a second answer is stale", async () => {
+  const pending = new Map<string, PendingExtensionRequest>();
+  const frames: object[] = [];
+  const deps: RpcInputFrameDeps = {
+    pendingExtensionRequests: pending,
+    output: frame => { frames.push(frame); },
+    handleCommand: async () => { throw new Error("UI responses must bypass the command queue"); },
+    errorResponse: (id, command, error) => ({ type: "response", id, command, success: false, error }),
+    onHostToolResult: () => {}, onHostToolUpdate: () => {}, onHostUriResult: () => {},
+  };
+  const result = requestRpcAskDialog(pending, deps.output, [{ id: "color", question: "Which color?", options: [{ label: "Mavi" }, { label: "Yesil" }] }]);
+  const question = frames[0] as { id: string };
+  const answer = { type: "extension_ui_response", id: question.id, responseId: "first", answers: [{ id: "color", selectedOptions: ["Yesil"] }] };
+  expect(dispatchRpcControlFrame(answer, deps)).toBe(true);
+  expect(await result).toMatchObject({ kind: "submit", results: [{ id: "color", selectedOptions: ["Yesil"] }] });
+  expect(pending.has(question.id)).toBe(false);
+  dispatchRpcControlFrame({ ...answer, responseId: "second" }, deps);
+  expect(frames.at(-1)).toMatchObject({ id: "second", success: false, error: { code: "stale_interaction" } });
+});
