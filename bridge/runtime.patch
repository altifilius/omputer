+	}
+
+	#record(args: Json): Json {
+		fields(args, ["action"]);
+		const action = args.action ?? "status";
+		if (action === "status") return this.#recordStatus();
+		if (action === "off") {
+			if (!this.#recording) fail("Conversation recording is not active", "not_recording");
+			const file = this.#recording?.file ?? null;
+			this.dispose();
+			return { status: "completed", ...this.#recordStatus(), file };
+		}
+		if (action !== "on") fail("Usage: /record on|off|status; records conversation events, not terminal pixels");
+		if (this.#recording) fail("Conversation recording is already active", "already_recording");
+		const snapshot = this.snapshot();
+		const artifacts = this.session.sessionManager.getArtifactsDir();
+		if (!artifacts) fail("Conversation recording requires a persisted session");
+		const directory = path.join(artifacts, "recordings");
+		fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+		const file = path.join(directory, `${Bun.randomUUIDv7()}.jsonl`);
+		const fd = openCloexecSync(file, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL, 0o600);
+		try {
+			fs.writeFileSync(fd, `${JSON.stringify({ type: "conversation_recording", version: 1, ...snapshot, timestamp: new Date().toISOString(), messages: this.session.messages })}\n`);
+			fs.fsyncSync(fd);
+		} catch (error) { fs.closeSync(fd); throw error; }
+		this.#recordError = undefined;
+		const recording = { fd, file, journalId: snapshot.journalId, unsubscribe: () => {}, events: 0 };
+		this.#recording = recording;
+		recording.unsubscribe = this.session.subscribe(event => {
+			if (this.snapshot().journalId !== recording.journalId) { this.dispose(); return; }
+			if (!["message_start", "message_update", "message_end", "agent_start", "agent_end", "turn_start", "turn_end"].includes(event.type)) return;
+			try {
+				fs.writeFileSync(fd, `${JSON.stringify({ type: "event", timestamp: new Date().toISOString(), event })}\n`);
+				recording.events++;
+				if (event.type === "message_end" || event.type === "agent_end") fs.fsyncSync(fd);
+			} catch {
+				this.#recordError = "Conversation recording write failed";
+				this.dispose();
+			}
+		});
+		return { status: "completed", ...this.#recordStatus() };
+	}
+
+	#recordStatus(): Json {
+		if (this.#recordError) fail(this.#recordError, "recording_failed");
+		return { ...this.snapshot(), semantic: "conversation_event_jsonl", terminalRecording: false, recording: !!this.#recording, file: this.#recording?.file ?? null, events: this.#recording?.events ?? 0 };
+	}
+
+	/** Flush and close the owned event recorder; no managed terminal capture is implied. */
+	dispose(): void {
+		const recording = this.#recording;
+		if (!recording) return;
+		this.#recording = undefined;
+		recording.unsubscribe();
+		try { fs.fsyncSync(recording.fd); } finally { fs.closeSync(recording.fd); }
+	}
+}
+
+export function createOmputerLocal(session: AgentSession, ctx: ExtensionContext): OmputerLocal {
+	return new OmputerLocal(session, ctx);
