+		{ name: "loop", risk: "execute", requiresIdle: true, inputHint: "[count|duration] [--while|--until 'command'] [prompt]", description: "Repeat turns with the owning continuation scheduler." },
+		{ name: "queue", risk: "provider", requiresIdle: false, inputHint: "literal follow-up", description: "Queue literal user input without prompt-template expansion." },
+		{ name: "tan", risk: "provider", requiresIdle: false, inputHint: "work", description: "Fork owner-scoped background work using the real tan controller." },
+		{ name: "omfg", risk: "provider", requiresIdle: true, inputHint: "complaint", description: "Generate, validate and explicitly review a TTSR rule before saving." },
+		{ name: "cleanse", risk: "execute", requiresIdle: true, inputHint: "[request] [--all] [--tests] [-n agents] [-m model]", description: "Discover, repair and verify project diagnostics." },
