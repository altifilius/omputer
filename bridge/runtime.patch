+		}
+		session.setPlanProposalHandler(null);
+		this.#previous = undefined;
+		session.sessionManager.appendModeChange("none");
+		await session.sessionManager.flush();
+	}
+
+	async approve(plan: ResolvedApprovedPlan): Promise<void> {
+		await autosaveApprovedPlan({ settings: this.session.settings, cwd: this.session.sessionManager.getCwd(),
+			title: plan.title, planContent: plan.planContent });
