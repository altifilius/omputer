@@ -0,0 +1,300 @@
+import { afterEach, describe, expect, it, spyOn } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { ExtensionContext } from "../../src/extensibility/extensions/types";
+import { MCPManager, type MCPManagerApi } from "../../src/mcp/manager";
+import type { AgentSession } from "../../src/session/agent-session";
+import type { AgentSessionEvent } from "../../src/session/agent-session-events";
+import { createOmputerLocal } from "../../src/session/omputer-local";
+import * as seanceResolver from "../../src/task/seance";
+import * as discovery from "../../src/task/discovery";
+import { getBundledAgent } from "../../src/task/agents";
+import type { AgentTool } from "@oh-my-pi/pi-agent-core";
+
+function fixture() {
+	const calls: string[] = [];
+	const state = { journalId: "original", source: "/isolated/original.jsonl", root: "/isolated/project", confirmed: true, cancelSwitch: false, refuseReset: false, deletionFails: false, lazyReplacement: false, edited: undefined as string | undefined };
+	const listeners = new Set<(event: AgentSessionEvent) => void>();
+	const disposers: Array<() => void> = [];
+	const messages: AgentMessage[] = [];
+	let confirmHook: (() => void) | undefined;
+	const manager = {
+		getSessionId: () => state.journalId,
+		getSessionFile: () => state.source,
+		getCwd: () => state.root,
+		getArtifactsDir: () => path.join(state.root, "artifacts"),
+		ensureOnDisk: async () => {
+			calls.push(`ensure:${state.journalId}`);
+			if (state.journalId === "replacement") state.source = "/isolated/replacement.jsonl";
+		},
+		flush: async () => { calls.push(`flush:${state.journalId}`); },
+		dropSession: async (file: string) => {
+			calls.push(`drop:${file}:active=${state.journalId}`);
+			if (state.deletionFails) throw new Error("fixture deletion failure");
+		},
+	};
+	const session = {
+		sessionManager: manager, messages, isStreaming: false, isBashRunning: false, isEvalRunning: false,
+		agent: { state: { tools: [] as AgentTool[] } },
+		addDisposer: (dispose: () => void) => { disposers.push(dispose); },
+		subscribe: (listener: (event: AgentSessionEvent) => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+		resetSessionContext: async () => {
+			calls.push("reset");
+			if (state.refuseReset) return undefined;
+			const droppedCount = messages.length;
+			messages.length = 0;
+			return { droppedCount };
+		},
+		newSession: async () => {
+			calls.push("new");
+			if (state.cancelSwitch) return false;
+			state.journalId = "replacement";
+			state.source = state.lazyReplacement ? "" : "/isolated/replacement.jsonl";
+			return true;
+		},
+	};
+	const context = {
+		mode: "rpc", agent: { id: "Main", kind: "main", name: "main", depth: 0 },
+		ui: {
+			confirm: async () => { calls.push("confirm"); confirmHook?.(); return state.confirmed; },
+			select: async (_title: string, choices: string[]) => choices[0],
+			editor: async () => state.edited,
+			input: async () => undefined,
+		},
+		hasPendingMessages: () => false,
+		shutdown: () => { calls.push("shutdown"); },
+	};
+	return { local: createOmputerLocal(session as unknown as AgentSession, context as unknown as ExtensionContext), state, calls, messages, session,
+		setConfirmHook: (hook: () => void) => { confirmHook = hook; },
+		emit: (event: AgentSessionEvent) => { for (const listener of listeners) listener(event); },
+		dispose: () => { for (const disposer of disposers) disposer(); },
+	};
+}
+
+function assistant(content: string): AgentMessage {
+	return { role: "assistant", content: [{ type: "text", text: content }], api: "openai-completions", provider: "fixture", model: "fixture", timestamp: 1,
+		usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } }, stopReason: "stop" };
+}
+
+const directories: string[] = [];
+afterEach(async () => { for (const directory of directories.splice(0)) await fs.rm(directory, { recursive: true, force: true }); });
+
+describe("Omputer local session lifecycle", () => {
+	it("clears model context through the session reset and flushes without changing journal identity", async () => {
+		const f = fixture();
+		f.messages.push({ role: "user", content: "old context", timestamp: 0 });
+		expect(await f.local.execute("clear")).toMatchObject({ status: "completed", journalId: "original", droppedCount: 1 });
+		expect(f.messages).toEqual([]);
+		expect(f.calls).toEqual(["confirm", "reset", "flush:original"]);
+	});
+
+	it("does not reset or delete when confirmation is cancelled", async () => {
+		const f = fixture();
+		f.state.confirmed = false;
+		await expect(f.local.execute("clear")).rejects.toMatchObject({ code: "cancelled" });
+		await expect(f.local.execute("delete")).rejects.toMatchObject({ code: "cancelled" });
+		expect(f.calls).toEqual(["confirm", "confirm"]);
+		expect(f.state.journalId).toBe("original");
+	});
+
+	it("rejects an identity changed during confirmation before touching either journal", async () => {
+		const f = fixture();
+		f.setConfirmHook(() => { f.state.journalId = "other-session"; });
+		await expect(f.local.execute("delete")).rejects.toMatchObject({ code: "stale_identity" });
+		expect(f.calls).toEqual(["confirm"]);
+	});
+
+	it("honors the session-before-switch cancellation without deleting the original", async () => {
+		const f = fixture();
+		f.state.cancelSwitch = true;
+		await expect(f.local.execute("delete")).rejects.toMatchObject({ code: "cancelled" });
+		expect(f.calls).toEqual(["confirm", "new"]);
+		expect(f.state.source).toBe("/isolated/original.jsonl");
+	});
+
+	it("deletes the captured original through its manager only after replacement is durable", async () => {
+		const f = fixture();
+		expect(await f.local.execute("delete")).toMatchObject({ status: "completed", deletedJournalId: "original", journalId: "replacement", source: "/isolated/replacement.jsonl" });
+		expect(f.calls).toEqual(["confirm", "new", "ensure:replacement", "flush:replacement", "drop:/isolated/original.jsonl:active=replacement"]);
+	});
+
+	it("materializes a lazy replacement before validating its source or dropping the original", async () => {
+		const f = fixture();
+		f.state.lazyReplacement = true;
+		expect(await f.local.execute("delete")).toMatchObject({ status: "completed", journalId: "replacement", source: "/isolated/replacement.jsonl" });
+		expect(f.calls).toEqual(["confirm", "new", "ensure:replacement", "flush:replacement", "drop:/isolated/original.jsonl:active=replacement"]);
+	});
+
+	it("reports deletion failure while leaving the valid replacement active", async () => {
+		const f = fixture();
+		f.state.deletionFails = true;
+		await expect(f.local.execute("delete")).rejects.toMatchObject({ code: "delete_failed", replacement: { journalId: "replacement" } });
+		expect(f.state.journalId).toBe("replacement");
+	});
+
+	it("never reports a refused reset as completed", async () => {
+		const f = fixture();
+		f.state.refuseReset = true;
+		await expect(f.local.execute("reset")).rejects.toMatchObject({ code: "session_busy" });
+		expect(f.calls).toEqual(["confirm", "reset"]);
+	});
+
+	it("rejects malformed deletion and busy lifecycle actions before confirmation", async () => {
+		const f = fixture();
+		await expect(f.local.execute("delete", "extra")).rejects.toMatchObject({ code: "invalid_arguments" });
+		f.session.isStreaming = true;
+		await expect(f.local.execute("clear")).rejects.toMatchObject({ code: "session_busy" });
+		expect(f.calls).toEqual([]);
+	});
+
+	it("returns host actions without exiting before delivery acknowledgment", async () => {
+		const f = fixture();
+		expect(await f.local.execute("exit")).toMatchObject({ status: "requires_parent", hostAction: "close", journalId: "original" });
+		expect(f.calls).not.toContain("shutdown");
+		f.local.acknowledgeShutdown(f.local.snapshot());
+		expect(f.calls).toContain("shutdown");
+		expect(await f.local.execute("restart")).toMatchObject({ status: "requires_parent", hostAction: "restart", requestRestart: true });
+	});
