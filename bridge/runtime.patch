+	expect(calls).toBe(0);
+});
+
+test("review hashes the actual artifact and refuses edits after human review", async () => {
+	await control("plan.enter");
+	await session.sessionManager.ensureOnDisk();
+	const planPath = resolvePlanFilePath("local://PLAN.md", { cwd: directory, localProtocolOptions: {
+		getArtifactsDir: () => session.sessionManager.getArtifactsDir(), getSessionId: () => session.sessionManager.getSessionId(),
+	} });
+	await Bun.write(planPath, "# Reviewed plan\n\nImplement the exact approved change.\n");
+	const reviewed = await control("plan.review");
+	const review = reviewed.review as { revision: string; planContent: string };
+	expect(review.planContent).toContain("Reviewed plan");
+	await Bun.write(planPath, "# Changed after review\n");
+	await expect(control("plan.approve", { revision: review.revision })).rejects.toMatchObject({ code: "stale_plan" });
+	expect(session.getPlanModeState()?.enabled).toBe(true);
+	expect(calls).toBe(0);
+});
