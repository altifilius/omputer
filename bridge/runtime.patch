+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { OmputerControls, type OmputerOutput } from "@oh-my-pi/pi-coding-agent/session/omputer-controls";
+import { bindOmputerHost } from "@oh-my-pi/pi-coding-agent/session/omputer-host";
+import { HeadlessPlanController } from "@oh-my-pi/pi-coding-agent/plan-mode/headless-controller";
+import { resolvePlanFilePath } from "@oh-my-pi/pi-coding-agent/plan-mode/plan-files";
+import { RpcGoalController } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-goal";
+import { RpcBtwController } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-btw";
+
+let auth: AuthStorage;
+let session: AgentSession;
+let controls: OmputerControls;
+let directory: string;
+let calls = 0;
+const output: OmputerOutput[] = [];
+
+beforeEach(async () => {
+	directory = await fs.mkdtemp(path.join(os.tmpdir(), "omputer-host-controls-"));
+	auth = await AuthStorage.create(":memory:");
+	auth.keys.setRuntime("anthropic", "test-key");
+	const registry = new ModelRegistry(auth, undefined, { ignoreLocalModelConfig: true });
+	const mock = createMockModel({ responses: [{ content: ["answer"] }, { content: ["next answer"] }] });
+	calls = 0; output.length = 0;
+	const runtime = new ExtensionRuntime();
+	const extension = await loadExtensionFromFactory(pi => {
+		pi.registerCommand("host-failure", { handler: async () => { throw new Error("Deliberate extension error"); } });
+		pi.registerCommand("host-literal", { handler: async (args, ctx) => { ctx.ui.notify(args); } });
+		pi.registerCommand("models", { handler: async () => { throw new Error("Builtin alias must win"); } });
+	}, directory, new EventBus(), runtime, "omputer-host-test");
+	const manager = SessionManager.create(directory, path.join(directory, "sessions"));
+	const extensionRunner = new ExtensionRunner([extension], runtime, directory, manager, registry);
+	session = new AgentSession({
+		agent: new Agent({ initialState: { model: getBundledModel("anthropic", "claude-sonnet-4-5")!, systemPrompt: ["Test"], tools: [] }, convertToLlm,
+			getApiKey: () => "test-key", streamFn: (...args) => { calls++; return mock.stream(...args); } }),
+		sessionManager: manager, extensionRunner, settings: Settings.isolated({ "compaction.enabled": false }), modelRegistry: registry,
+	});
+	const plan = new HeadlessPlanController(session);
+	const goal = new RpcGoalController(session);
+	session.subscribe(event => goal.observe(event));
+	bindOmputerHost(session, { plan, goal, btw: new RpcBtwController(session, () => {}) });
+	controls = OmputerControls.create({} as ExtensionAPI, { agent: { id: "Main" } } as ExtensionContext, session);
+});
+afterEach(async () => { await session.dispose(); auth.close(); await fs.rm(directory, { recursive: true, force: true }); });
+
+async function command(commandId: string, args = "", confirmed = true) {
+	const catalog = await controls.catalog();
+	return controls.execute("session.command", { commandId, args, confirmed, catalogRevision: catalog.catalogRevision, expectedJournalId: session.sessionManager.getSessionId() }, "op-one", event => output.push(event));
+}
+async function control(name: string, args: Record<string, unknown> = {}) {
+	return controls.execute("session.control", { control: name, arguments: args, confirmed: true, expectedJournalId: session.sessionManager.getSessionId() }, "op-control", event => output.push(event));
+}
+
+test("catalog/read discovery never invokes a provider, and unknown/stale/unavailable cannot fall back", async () => {
+	const catalog = await controls.catalog();
+	expect(Array.isArray(catalog.commands)).toBe(true);
+	await controls.query("models"); await controls.query("state"); await controls.query("usage");
+	await expect(command("builtin:not-a-command")).rejects.toMatchObject({ code: "unknown_command" });
+	await expect(command("builtin:share")).rejects.toMatchObject({ code: "unsupported" });
+	await expect(controls.execute("session.command", { commandId: "builtin:context", args: "", catalogRevision: "stale", expectedJournalId: session.sessionManager.getSessionId() }, "op", () => {})).rejects.toMatchObject({ code: "stale_catalog" });
+	expect(calls).toBe(0);
+});
+
+test("session account/deletion and usage mutations reject even when catalog risk is read", async () => {
+	await expect(command("builtin:session", "delete", false)).rejects.toMatchObject({ code: "unsupported" });
+	await expect(command("builtin:session", "pin some-account", false)).rejects.toMatchObject({ code: "unsupported" });
+	await expect(command("builtin:usage", "reset anthropic/active", false)).rejects.toMatchObject({ code: "unsupported" });
+	expect(calls).toBe(0);
+});
+
+test("text builtin output is correlated to the caller operation, not the most recent prompt", async () => {
+	await command("builtin:session", "info", false);
+	expect(output.length).toBeGreaterThan(0);
+	expect(output.every(event => event.operationId === "op-one" && event.type === "operation_output")).toBe(true);
+	expect(calls).toBe(0);
+});
+
+test("file command arguments stay literal and normal slash message mode is distinct", async () => {
+	session.setSlashCommands([{ name: "literal-test", description: "literal", source: "test", content: "$ARGUMENTS" }]);
+	// The session loader adds its bundled files; use a prompt template to exercise the same literal pipeline.
+	const templates = session.promptTemplates as Array<{ name: string; description: string; source: string; content: string }>;
+	templates.push({ name: "literal-template", description: "test", source: "test", content: "$ARGUMENTS" });
+	await command("template:literal-template", "$(touch NEVER) ; literal");
+	expect(calls).toBe(1);
+	await session.prompt("/definitely-unknown", { runCommands: false, expandPromptTemplates: false });
+	expect(calls).toBe(2);
+	expect(await Bun.file(path.join(directory, "NEVER")).exists()).toBe(false);
