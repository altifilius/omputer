+import { expect, test } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+const sessionRoot = path.resolve(import.meta.dir, "../src/session");
+const python = String.raw`
+import json, os, socket, subprocess, sys
+name, code, source, session_id, scenario = sys.argv[1:]
+lease = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+lease.bind(bytes([0]) + name.encode())
+env = dict(os.environ, OMPUTER_SESSION_LEASE_FD=str(lease.fileno()), OMPUTER_SESSION_LEASE_ID=session_id)
+if scenario == 'bad-fd': env['OMPUTER_SESSION_LEASE_FD'] = '2147483647'
+p = subprocess.Popen([os.environ['BUN_EXECUTABLE'], '-e', code, source, session_id], env=env,
+    pass_fds=(lease.fileno(),), stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+try:
+    if scenario != 'valid':
+        out, err = p.communicate(timeout=20)
+        print(json.dumps({'rejected':p.returncode != 0, 'stdout':out, 'stderr':err}))
+    else:
+        first = p.stdout.readline()
+        if not first: raise RuntimeError('native child failed: ' + p.stderr.read())
+        ready = json.loads(first)
+        lease.close()
+        probe = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+        try:
+            probe.bind(bytes([0]) + name.encode())
+            raise RuntimeError('lease lost before child released holders')
+        except OSError: pass
+        finally: probe.close()
+        p.stdin.write('release'); p.stdin.close()
+        last = p.stdout.readline()
+        if not last:
+            raise RuntimeError('native child failed after release: ' + p.stderr.read())
+        released = json.loads(last)
+        if p.wait(timeout=20) != 0: raise RuntimeError(p.stderr.read())
+        probe = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+        probe.bind(bytes([0]) + name.encode())
+        probe.close()
+        print(json.dumps({'ready':ready, 'released':released, 'availableAfterExit':True}))
+finally:
+    lease.close()
+    if p.poll() is None:
+        p.kill(); p.wait()
+`;
+
+const child = `
+// This subprocess intentionally loads modules after inherited-FD startup; it is
+// a module-loading boundary regression, separate from the test runner's cache.
+const fs = await import('node:fs');
+const { FileSessionStorage, tryAcquireSessionLease } = await import(${JSON.stringify(`${sessionRoot}/session-storage.ts`)});
+const { acceptedSessionLeaseHandoff } = await import(${JSON.stringify(`${sessionRoot}/inherited-session-lease.ts`)});
+const { SessionManager } = await import(${JSON.stringify(`${sessionRoot}/session-manager.ts`)});
+const { Shell } = await import('@oh-my-pi/pi-natives');
+const source = process.argv[1], id = process.argv[2];
+const storage = new FileSessionStorage();
+const release1 = storage.claimSession(id, source);
+const release2 = new FileSessionStorage().claimSession(id, source);
+if (!release1 || !release2) throw new Error('valid lease handoff rejected');
+const manager = await SessionManager.open(source, undefined, storage);
+if (manager.getSessionId() !== id || manager.getSessionFile() !== source) throw new Error('resume forked unexpectedly');
+// Opening a transcript is read-only until the first write. Materialize a real
+// manager holder before releasing the two explicit storage claims.
+manager.appendCustomEntry('lease-fixture', { claimed: true });
+await manager.flush();
+const socketLinks = new Set(fs.readdirSync('/proc/self/fd').flatMap(fd => {
+ try { const link = fs.readlinkSync('/proc/self/fd/' + fd); return link.startsWith('socket:') ? [link] : []; } catch { return []; }
+}));
+let descendants = '';
+await new Shell().run({command:"sh -c 'ls -l /proc/$$/fd'",cwd:process.cwd()}, (_err, chunk) => { descendants += chunk; });
+const leaked = [...socketLinks].filter(link => descendants.includes(link));
+console.log(JSON.stringify({handoff:acceptedSessionLeaseHandoff(manager.getSessionId(), manager.getSessionFile()), count:manager.getEntries().filter(e=>e.type==='message').length, leaked, envCleared:process.env.OMPUTER_SESSION_LEASE_FD === undefined && process.env.OMPUTER_SESSION_LEASE_ID === undefined}));
+await new Response(Bun.stdin.stream()).text();
+release1();
+release2();
+const managerProbe = tryAcquireSessionLease(id);
+const heldWhileManagerOpen = managerProbe === null;
+managerProbe?.release();
+await manager.close();
+const available = tryAcquireSessionLease(id);
+if (!available) throw new Error('lease leaked after last holder');
+available.release();
+console.log(JSON.stringify({heldWhileManagerOpen, available:true}));
+`;
+
+test.skipIf(process.platform !== "linux")("native startup adopts the exact inherited lease across shared holders and resume", async () => {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "omp-inherited-lease-"));
+	try {
+		const id = crypto.randomUUID();
+		const source = path.join(root, "saved.jsonl");
+		fs.writeFileSync(source, `${JSON.stringify({type:"session",version:3,id,cwd:root,timestamp:new Date().toISOString()})}\n${JSON.stringify({type:"message",id:"message1",parentId:null,timestamp:new Date().toISOString(),message:{role:"user",content:"preserved queued history",timestamp:1}})}\n`);
+		const owners = path.join(root, "owners");
+		const key = path.join(owners, `${id}.lock`);
+		const high = Bun.hash.xxHash64(key, 0x4f4d502d4c4f434bn).toString(16).padStart(16, "0");
+		const low = Bun.hash.xxHash64(key, 0x50492d46494c454cn).toString(16).padStart(16, "0");
+		for (const scenario of ["valid", "bad-fd", "wrong-name"]) {
+			const name = scenario === "wrong-name" ? `omp-file-lock-${"0".repeat(32)}` : `omp-file-lock-${high}${low}`;
+			const proc = Bun.spawn(["python3", "-c", python, name, child, source, id, scenario], {
+				cwd:path.resolve(import.meta.dir, ".."), stdout:"pipe", stderr:"pipe",
+				env:{PATH:process.env.PATH, HOME:root, XDG_STATE_HOME:root, PI_CODING_AGENT_DIR:path.join(root,"agent"), PI_TEST_SESSION_OWNERS_DIR:owners, BUN_EXECUTABLE:process.execPath},
+			});
+			const output = await new Response(proc.stdout).text();
+			const errors = await new Response(proc.stderr).text();
+			expect(await proc.exited, errors).toBe(0);
+			const result = JSON.parse(output);
+			if (scenario !== "valid") { expect(result.rejected).toBe(true); continue; }
+			expect(result.ready.handoff).toEqual({journalId:id,source});
+			expect(result.ready.count).toBe(1);
+			expect(result.ready.envCleared).toBe(true);
+			expect(result.ready.leaked).toEqual([]);
+			expect(result.released).toEqual({heldWhileManagerOpen:true,available:true});
+			expect(result.availableAfterExit).toBe(true);
+		}
+	} finally { fs.rmSync(root, {recursive:true,force:true}); }
+}, 60_000);
+
+const cliPython = String.raw`
+import errno, json, os, select, socket, subprocess, sys
+name, cli, source, session_id = sys.argv[1:]
+lease = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+lease.bind(bytes([0]) + name.encode())
+env = dict(os.environ, OMPUTER_SESSION_LEASE_FD=str(lease.fileno()), OMPUTER_SESSION_LEASE_ID=session_id)
+p = subprocess.Popen([os.environ['BUN_EXECUTABLE'], cli, '--mode', 'rpc-ui', '--no-ui', '--no-title',
+    '--no-extensions', '--no-skills', '--no-rules', '--no-tools', '--provider', 'anthropic',
+    '--model', 'claude-sonnet-4-5', '--resume', source], env=env, cwd=os.environ['HOME'],
+    pass_fds=(lease.fileno(),), stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+def receive():
+    if not select.select([p.stdout], [], [], 25)[0]: raise RuntimeError('CLI readiness timed out')
+    line = p.stdout.readline()
+    if not line: raise RuntimeError('CLI exited before readiness: ' + p.stderr.read())
+    return json.loads(line)
+try:
+    frame = receive()
+    while frame.get('type') != 'ready': frame = receive()
+    if frame.get('sessionLeaseHandoff') != {'journalId':session_id, 'source':source}:
+        raise RuntimeError('CLI accepted a different handoff: ' + repr(frame))
+    lease.close()
+    probe = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+    try:
+        probe.bind(bytes([0]) + name.encode())
+        raise RuntimeError('CLI ready without retaining its inherited writer lease')
+    except OSError as error:
+        if error.errno != errno.EADDRINUSE: raise
+    finally: probe.close()
+    p.stdin.close()
+    if p.wait(timeout=25) != 0: raise RuntimeError('CLI shutdown failed: ' + p.stderr.read())
+    probe = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+    probe.bind(bytes([0]) + name.encode())
+    probe.close()
+    print(json.dumps({'handoff':frame['sessionLeaseHandoff'], 'availableAfterExit':True}))
+finally:
+    lease.close()
+    if p.poll() is None:
+        p.kill(); p.wait()
+`;
+
+test.skipIf(process.platform !== "linux")("actual CLI resume accepts an inherited lease before ready without a prior write or manual claim", async () => {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "omp-cli-inherited-resume-"));
+	let requests = 0;
+	const server = Bun.serve({ hostname:"127.0.0.1", port:0, fetch() { requests++; return new Response("No model request is allowed", {status:500}); } });
+	try {
+		const id = crypto.randomUUID();
+		const source = path.join(root, "saved.jsonl");
+		fs.writeFileSync(source, `${JSON.stringify({type:"session",version:3,id,cwd:root,timestamp:new Date().toISOString()})}\n`);
+		const owners = path.join(root, "owners");
+		const key = path.join(owners, `${id}.lock`);
+		const high = Bun.hash.xxHash64(key, 0x4f4d502d4c4f434bn).toString(16).padStart(16, "0");
+		const low = Bun.hash.xxHash64(key, 0x50492d46494c454cn).toString(16).padStart(16, "0");
+		const agent = path.join(root, "agent");
+		fs.mkdirSync(agent);
+		fs.writeFileSync(path.join(agent, "models.yml"), `providers:\n  anthropic:\n    baseUrl: http://127.0.0.1:${server.port}\n    apiKey: synthetic-no-request\n`);
+		const proc = Bun.spawn(["python3", "-c", cliPython, `omp-file-lock-${high}${low}`, path.resolve(import.meta.dir,"../src/cli.ts"), source, id], {
+			cwd:root, stdout:"pipe", stderr:"pipe",
+			env:{PATH:process.env.PATH, HOME:root, XDG_STATE_HOME:root, XDG_CONFIG_HOME:root, XDG_DATA_HOME:root, PI_CODING_AGENT_DIR:agent, PI_TEST_SESSION_OWNERS_DIR:owners, BUN_EXECUTABLE:process.execPath, PI_NOTIFICATIONS:"off", NO_COLOR:"1"},
+		});
+		const output = await new Response(proc.stdout).text();
+		const errors = await new Response(proc.stderr).text();
+		expect(await proc.exited, errors).toBe(0);
+		expect(JSON.parse(output)).toEqual({handoff:{journalId:id,source},availableAfterExit:true});
+		expect(requests).toBe(0);
+	} finally {
+		server.stop(true);
+		fs.rmSync(root,{recursive:true,force:true});
+	}
+}, 60_000);
