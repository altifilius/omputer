+import { beforeAll, describe, expect, it } from "bun:test";
+import { workingRowTrailer } from "@oh-my-pi/pi-coding-agent/modes/working-row-trailer";
+import { type TUI, visibleWidth } from "@oh-my-pi/pi-tui";
+import { Loader } from "@oh-my-pi/pi-tui/components/loader";
+import { type ComposerResourceUsage, CustomEditor } from "@oh-my-pi/pi-tui/prompt/custom-editor";
+import { getEditorTheme, initTheme } from "@oh-my-pi/pi-tui/theme";
+
+const usage: ComposerResourceUsage = {
+	cpuPercent: 236,
+	memoryBytes: 768 * 1024 * 1024,
+	swapBytes: 32 * 1024 * 1024,
+	gpuPercent: 42,
+	vramBytes: 2 * 1024 * 1024 * 1024,
+	processCount: 7,
+	partial: false,
+};
+beforeAll(async () => {
+	await initTheme();
+});
+
+describe("above-input throughput and resource trailer", () => {
+	it("keeps field resources beside tok/s on the active working row without adding an editor row", () => {
+		const editor = new CustomEditor(getEditorTheme());
+		editor.setBorderStyle("field");
+		const baseline = editor.render(120);
+		editor.resourceUsage = usage;
+		const loader = new Loader(
+			{ requestComponentRender() {} } as unknown as TUI,
+			s => s,
+			s => s,
+			"Working",
+			[" esc"],
+		);
+		loader.stop();
+		loader.setTrailer(width =>
+			workingRowTrailer(width, "35.5 tok/s", available => editor.resourceLabel(available), undefined),
+		);
+		const lines = loader.render(120);
+		expect(lines).toHaveLength(2);
+		const row = Bun.stripANSI(lines[1]!);
+		expect(row).toContain("esc Working");
+		expect(row).toMatch(/35\.5 tok\/s\s+CPU/);
+		for (const metric of ["RAM", "SWAP", "GPU", "VRAM"]) expect(row).toContain(metric);
+		expect(editor.render(120)).toEqual([...baseline]);
+		for (let width = 30; width <= 120; width++) {
+			const rendered = loader.render(width);
+			for (const line of rendered) expect(visibleWidth(line)).toBeLessThanOrEqual(width);
+			expect(Bun.stripANSI(rendered[1]!)).toContain("35.5 tok/s");
+		}
+		const narrow = Bun.stripANSI(loader.render(55)[1]!);
+		expect(narrow).toContain("CPU");
+		expect(narrow).toContain("RAM");
+		loader.setTrailer(width =>
+			workingRowTrailer(width, undefined, available => editor.resourceLabel(available), undefined),
+		);
+		expect(Bun.stripANSI(loader.render(120)[1]!)).toContain("CPU");
+		editor.resourceUsage = undefined;
+		expect(Bun.stripANSI(loader.render(120)[1]!)).not.toContain("CPU");
+	});
+
+	it("bounds idle and unmeasured-token trailers and reads switched or cleared snapshots lazily", () => {
+		const editor = new CustomEditor(getEditorTheme());
+		const resources = (width: number) => editor.resourceLabel(width);
+		editor.resourceUsage = usage;
+		for (const rate of [undefined, "35.5 tok/s"]) {
+			for (let width = 0; width <= 120; width++) {
+				const trailer = workingRowTrailer(width, rate, resources, "A long band session title");
+				expect(visibleWidth(trailer ?? "")).toBeLessThanOrEqual(width);
+				if (rate && width >= rate.length) expect(Bun.stripANSI(trailer!)).toStartWith(rate);
+			}
+		}
+		expect(Bun.stripANSI(workingRowTrailer(120, undefined, resources, undefined)!)).toStartWith("CPU");
+		editor.resourceUsage = { ...usage, cpuPercent: 12 };
+		expect(Bun.stripANSI(workingRowTrailer(120, "35.5 tok/s", resources, undefined)!)).toContain("CPU 12%");
+		editor.resourceUsage = undefined;
+		expect(workingRowTrailer(120, "35.5 tok/s", resources, undefined)).toBe("35.5 tok/s");
+		expect(workingRowTrailer(120, undefined, resources, undefined)).toBeUndefined();
+	});
+});
diff --git a/packages/coding-agent/examples/extensions/resource-queue/index.ts b/packages/coding-agent/examples/extensions/resource-queue/index.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/resource-queue/index.ts
@@ -0,0 +1,190 @@
+import type { ExtensionAPI, ExtensionContext } from "@oh-my-pi/pi-coding-agent";
+import type { AsyncJobManagerApi } from "@oh-my-pi/pi-coding-agent/async/job-manager";
+import { AgentRegistry } from "@oh-my-pi/pi-coding-agent/registry/agent-registry";
+import { isLocalAgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session-handle";
+import { FamilyActivity, ResourceQueue, type QueueState } from "./queue";
+
+export function diagnostic(command: unknown): boolean {
+	// Only literal read-only commands, never shell composition or interpreters.
+	if (typeof command !== "string" || !/^[a-zA-Z0-9_ /.,:%=+-]+$/.test(command)) return false;
+	const [program, ...args] = command.trim().split(/\s+/);
+	const name = program.replace(/^\/(?:usr\/)?bin\//, "");
+	if (name === "ps" || name === "uptime") return true;
+	if (name === "free") {
+		return args.every(arg => /^(-[bkmghwltv]|--(?:bytes|kibi|mebi|gibi|human|wide|lohi|total|version))$/.test(arg));
+	}
+	if (name === "cat") {
+		return args.length > 0 && args.every(arg => /^\/proc\/(meminfo|loadavg|pressure\/(cpu|memory|io))$/.test(arg));
+	}
+	if (name === "systemctl") {
+		const rest = args[0] === "--user" ? args.slice(1) : args;
+		return rest[0] === "show" && rest.slice(1).every(arg => /^(--property=[\w,]+|-[pP]|[\w.@,-]+)$/.test(arg));
+	}
+	return false;
+}
+
+function scopedJobs(ctx: ExtensionContext): AsyncJobManagerApi | undefined {
+	const session = AgentRegistry.global().get(ctx.agent.id)?.session;
+	// The registry bridge returns the actual local session on its home thread,
+	// whose manager is either this root's manager or its worker-side proxy.
+	// Never route through AsyncJobManager.instance(): it points at the first root.
+	if (!session || !isLocalAgentSession(session)) return undefined;
+	if (session.sessionManager.getSessionId() !== ctx.sessionManager.getSessionId()) return undefined;
+	return session.asyncJobManager;
+}
+
+export default function resourceQueue(pi: ExtensionAPI) {
+	// Extension factories are rebound for child sessions and worker threads.
+	// The database merges their independent claims by PID + process start time.
+	let queue: ResourceQueue | undefined;
+	let activity: FamilyActivity | undefined;
+	let manager: AsyncJobManagerApi | undefined;
+	let waiters = 0;
+	let shuttingDown = false;
+	const cancellations = new Set<AbortController>();
+
+	function releaseIdle(): void {
+		if (!waiters && !shuttingDown) queue?.release();
+	}
+
+	function finish(ctx: ExtensionContext, id: string, tool: string): void {
+		activity?.finish(`${ctx.agent.id}:${id}:${tool}`);
+	}
+
+	pi.on("tool_call", async (event, ctx) => {
+		const nativeWork = event.toolName === "bash" || event.toolName === "eval" || event.toolName === "task";
+		const devicePath = event.toolName === "write" && typeof event.input.path === "string" ? event.input.path : "";
+		if (!nativeWork && !devicePath.startsWith("xd://") && !event.toolName.startsWith("mcp__playwright_")) return;
+		if (event.toolName === "bash" && !event.input.name && !event.input.async && diagnostic(event.input.command))
+			return;
+		if (shuttingDown) return { block: true, reason: "OMP is shutting down; no new work was started" };
+		const jobs = scopedJobs(ctx);
+		if (!jobs || (manager && jobs !== manager)) {
+			return {
+				block: true,
+				reason: "Resource queue cannot resolve this session's job manager; no work was started",
+			};
+		}
+		const key = `${ctx.agent.id}:${event.toolCallId}:${event.toolName}`;
+		let state: QueueState;
+		try {
+			queue ??= new ResourceQueue();
+			manager = jobs;
+			activity ??= new FamilyActivity(jobs, releaseIdle);
+			state = queue.poll();
+		} catch (error) {
+			activity?.check();
+			return { block: true, reason: `Resource queue unavailable; no work was started: ${String(error)}` };
+		}
+		if (state.admitted) {
+			activity.start(key, ctx.agent.id);
+			return;
+		}
+		if (!ctx.hasUI) {
+			activity.check();
+			return { block: true, reason: `${state.reason}. Use interactive OMP for cancellable admission waiting` };
+		}
+
+		const lease = queue;
+		const active = activity;
+		const controller = new AbortController();
+		cancellations.add(controller);
+		waiters++;
+		let admitted = false;
+		let failed: string | undefined;
+		let completed = false;
+		const poll = ctx.setInterval(() => {
+			if (completed || controller.signal.aborted || admitted || shuttingDown) return;
+			try {
+				const next = lease.poll();
+				ctx.ui.setStatus("resource-queue", `Queue ${next.position} · ${next.reason || "Starting"}`);
+				if (next.admitted) {
+					admitted = true;
+					active.start(key, ctx.agent.id);
+					controller.abort();
+				}
+			} catch (error) {
+				failed = String(error);
+				controller.abort();
+			}
+		}, 250);
+		try {
+			// The native selector pauses the handler deadline and inherits handler
+			// cancellation. Tools, approval, batching and renderers stay native.
+			await ctx.ui.select(`Queued (${state.position}) · ${state.reason}`, ["Cancel this request"], {
+				signal: controller.signal,
+				helpText:
+					"Starts automatically when admitted. Esc cancels. Diagnostics and proc:// controls remain available.",
+			});
+			if (!admitted) {
+				return { block: true, reason: failed ? `Resource queue failed: ${failed}` : "Queued request cancelled" };
+			}
+		} catch (error) {
+			if (!admitted) return { block: true, reason: `Resource wait cancelled: ${String(error)}` };
+		} finally {
+			completed = true;
+			ctx.clearTimer(poll);
+			cancellations.delete(controller);
+			waiters--;
+			active.check();
+			ctx.ui.setStatus("resource-queue", undefined);
+		}
+	});
+
+	pi.on("tool_execution_end", (event, ctx) => finish(ctx, event.toolCallId, event.toolName));
+	pi.on("tool_result", (event, ctx) => finish(ctx, event.toolCallId, event.toolName));
+	pi.on("agent_end", (_event, ctx) => {
+		activity?.finishOwner(ctx.agent.id);
+	});
+	pi.on("tool_approval_resolved", (event, ctx) => {
+		if (!event.approved) finish(ctx, event.toolCallId, event.toolName);
+	});
+	pi.on("session_switch", (_event, ctx) => {
+		activity?.finishOwner(ctx.agent.id);
+	});
+
+	pi.registerCommand("resource-queue", {
+		description: "Show the resource queue policy; cancel pending admission with cancel",
+		handler: async (args, ctx) => {
+			if (args.trim() === "cancel") {
+				for (const controller of cancellations) controller.abort();
+				ctx.ui.notify("Pending resource requests cancelled; running jobs were not stopped", "info");
+			} else {
+				ctx.ui.notify(
+					waiters
+						? "Queued work starts automatically. /resource-queue cancel only cancels pending admission."
+						: "OMP process families run FIFO until their managed jobs settle. CPU pressure alone does not block admission.",
+					"info",
+				);
+			}
+		},
+	});
+
+	pi.on("session_shutdown", (_event, ctx) => {
+		shuttingDown = true;
+		for (const controller of cancellations) controller.abort();
+		ctx.ui.setStatus("resource-queue", undefined);
+		if (ctx.agent.kind === "main") {
+			activity?.stop();
+			// Shutdown precedes native cancellation. Retain this claim until PID
+			// exit, not merely until the shutdown event or cancel status is emitted.
+			queue?.close({ release: false });
+		} else if (queue && manager) {
+			activity?.stop();
+			const lease = queue;
+			const jobManager = manager;
+			// A child's parent task can still be awaiting this shutdown handler.
+			// Do not await its manager here: release asynchronously after settlement.
+			void (async () => {
+				try {
+					await jobManager.waitForAll();
+					if (!(await jobManager.waitForOwnerJobs(ctx.agent.id))) throw new Error("Child jobs did not settle");
+					await jobManager.waitForAll();
+					lease.close();
+				} catch {
+					lease.close({ release: false });
+				}
+			})();
+		}
+	});
+}
