+	it("uses PSS and SwapPss without substituting double-counted RSS or unsupported zero", () => {
+		expect(parseResourceMemory("Rss: 900 kB\nPss: 123 kB\nSwap: 80 kB\nSwapPss: 30 kB\n")).toEqual({
+			memoryBytes: 123 * 1024,
