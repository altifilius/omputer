+			}
+			if (args.target === "command") {
+				const command = extractLastCommand(this.session.messages);
+				if (!command) fail("No bash or eval command to copy", "not_found");
+				return { status: "requires_parent", ...before, action: { kind: "clipboard", target: "command", text: command.code, language: command.language } };
+			}
