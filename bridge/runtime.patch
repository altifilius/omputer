+	}
+
+	async #control(control: string, args: Json, output: (text: string) => void): Promise<Json> {
+		const session = this.#session; const manager = session.sessionManager; const host = getOmputerHost(session);
+		if (control === "queue.remove" || control === "queue.edit" || control === "queue.promote") {
+			const message = required(args, "message");
+			const queue = args.queue;
+			if (control !== "queue.promote" && queue !== "steering" && queue !== "followUp") fail("invalid_arguments", "queue must be steering or followUp");
+			if (control === "queue.promote") {
+				if (!session.promoteQueuedMessage(message)) fail("stale_queue", "Message was already consumed or removed.");
+				return { promoted: true };
+			}
+			if (control === "queue.edit") {
+				if (!session.editQueuedMessage(message, queue as "steering" | "followUp", required(args, "text"))) fail("stale_queue", "Message was already consumed or removed.");
+				return { edited: true };
+			}
+			const removed = session.takeQueuedMessage(message, queue as "steering" | "followUp");
+			if (!removed) fail("stale_queue", "Message was already consumed or removed.");
+			return { removed };
+		}
+		if (control === "jobs.cancel") {
+			if (!session.cancelAsyncJob(required(args, "id"))) fail("stale_job", "No running owned job has this ID.");
+			return { cancelled: true };
+		}
+		if (control.startsWith("todo.")) {
+			const name = control.slice(5);
+			if (!["append", "start", "done", "drop", "rm"].includes(name)) fail("unsupported", "Unsupported todo mutation.");
+			return this.#command({ id: "builtin:todo", name: "todo", source: "builtin", aliases: [], description: "", subcommands: [], available: true, risk: "change", requiresIdle: false }, `${name} ${typeof args.args === "string" ? args.args : ""}`, output);
+		}
+		if (!host) fail("unsupported", "The owning host controllers are unavailable.");
+		if (control === "btw.ask") {
+			const completed = Promise.withResolvers<BtwHistoryRecord>();
+			let recordId: string | undefined;
+			const pending = new Map<string, BtwHistoryRecord>();
+			let previousAnswer = "";
+			const observe = (record: BtwHistoryRecord) => {
+				if (recordId === undefined) { pending.set(record.id, record); return; }
+				if (record.id !== recordId) return;
+				const latest = getBtwLatestTurn(record);
+				if (latest.answer.startsWith(previousAnswer)) output(latest.answer.slice(previousAnswer.length));
+				previousAnswer = latest.answer;
+				if (latest.status !== "running") completed.resolve(record);
+			};
+			const off = host.btw.subscribe(observe);
+			try {
+				const record = await host.btw.ask(required(args, "question"), typeof args.recordId === "string" ? args.recordId : undefined);
+				recordId = record.id; observe(pending.get(recordId) ?? record);
+				const terminal = await completed.promise;
+				const latest = getBtwLatestTurn(terminal);
+				if (latest.status === "error") fail("btw_error", latest.error ?? "Side question failed.");
+				return { record: terminal, cancelled: latest.status === "cancelled" };
+			} finally { off(); }
+		}
+		if (control === "btw.cancel") {
+			if (!host.btw.cancel(typeof args.recordId === "string" ? args.recordId : undefined)) fail("stale_btw", "No matching side question is running.");
+			return { cancelled: true };
+		}
+		this.#requireIdle();
+		if (control.startsWith("goal.")) {
+			const op = control.slice(5);
+			if (op !== "create" && op !== "resume" && op !== "pause" && op !== "drop") fail("unsupported", "Unknown goal action.");
+			if (args.token_budget !== undefined && (typeof args.token_budget !== "number" || !Number.isSafeInteger(args.token_budget) || args.token_budget <= 0)) fail("invalid_arguments", "token_budget must be a positive integer");
+			const result = await host.goal.handle({ op, objective: typeof args.objective === "string" ? args.objective : undefined, token_budget: args.token_budget as number | undefined });
+			await manager.flush(); return { ...result };
+		}
+		if (control === "plan.enter") { await host.plan.enter(); await manager.flush(); this.#review = undefined; return this.query("plan"); }
+		if (control === "plan.cancel") { await host.plan.cancel(); await manager.flush(); this.#review = undefined; return this.query("plan"); }
+		if (control === "plan.review") {
+			const state = session.getPlanModeState(); if (!state?.enabled) fail("invalid_state", "Plan mode is not active.");
+			const options = { localProtocolOptions: { getArtifactsDir: () => manager.getArtifactsDir(), getSessionId: () => manager.getSessionId() }, cwd: manager.getCwd() };
+			const plan = await resolveApprovedPlan({ suppliedTitle: args.title, statePlanFilePath: state.planFilePath, readPlan: url => readPlanFile(url, options), listPlanFiles: () => listPlanFiles(options) });
+			this.#review = { ...plan, journalId: manager.getSessionId(), leafId: manager.getLeafId(), revision: digest([manager.getSessionId(), manager.getLeafId(), plan]) };
+			return this.query("plan");
+		}
+		if (control === "plan.approve") {
+			const review = this.#review;
+			if (!review || args.revision !== review.revision || review.journalId !== manager.getSessionId() || review.leafId !== manager.getLeafId()) fail("stale_plan", "Review the current plan before approving.");
+			const content = await readPlanFile(review.planFilePath, { localProtocolOptions: { getArtifactsDir: () => manager.getArtifactsDir(), getSessionId: () => manager.getSessionId() }, cwd: manager.getCwd() });
+			if (content !== review.planContent) fail("stale_plan", "Plan content changed after review; review it again.");
+			await host.plan.approve(review); this.#review = undefined; await manager.flush(); return { approved: true };
+		}
+		if (control === "tree.navigate" || control === "branch" || control === "fork") {
+			const entryId = control === "fork" && args.entryId === undefined ? undefined : required(args, "entryId");
+			if (entryId && !manager.getEntry(entryId)) fail("stale_entry", "Entry does not belong to this journal.");
+			await host.btw.close(); await host.goal.beginSessionChange();
+			try {
+				let result: Json;
+				if (control === "branch") result = { ...await session.branch(entryId!) };
+				else if (control === "fork") result = { cancelled: !(await session.fork(entryId, { requireIdle: true })) };
+				else result = { ...await session.navigateTree(entryId!, { summarize: args.summarize === true }) };
+				await manager.ensureOnDisk(); await manager.flush(); this.#review = undefined;
+				return { ...result, journalId: manager.getSessionId(), sessionFile: manager.getSessionFile(), leafId: manager.getLeafId() };
+			} finally { await host.goal.endSessionChange(); }
+		}
+		fail("unsupported", `Unknown session control: ${control}`);
+	}
+}
diff --git a/packages/coding-agent/src/session/omputer-host.ts b/packages/coding-agent/src/session/omputer-host.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/session/omputer-host.ts
@@ -0,0 +1,37 @@
+import type { AgentSession } from "./agent-session";
+import type { BtwHistoryRecord } from "./btw-history";
+import type { ResolvedApprovedPlan } from "../plan-mode/approved-plan";
+import type { RpcGoalCommand, RpcGoalResult } from "../modes/rpc/rpc-goal";
+
+/** The owning UI/RPC mode supplies its actual controllers, never a second driver. */
+export interface OmputerHostControllers {
+	plan: {
+		enter(): Promise<void>;
+		cancel(): Promise<void>;
+		approve(plan: ResolvedApprovedPlan): Promise<void>;
+	};
+	goal: {
+		handle(command: RpcGoalCommand): Promise<RpcGoalResult>;
+		settled(): Promise<void>;
+		beginSessionChange(): Promise<void>;
+		endSessionChange(): Promise<void>;
+	};
+	btw: {
+		ask(question: string, recordId?: string): Promise<BtwHistoryRecord>;
+		subscribe(listener: (record: BtwHistoryRecord) => void): () => void;
+		cancel(recordId?: string): boolean;
+		history(): Promise<readonly BtwHistoryRecord[]>;
+		close(): Promise<void>;
+	};
+}
+
+const hosts = new WeakMap<AgentSession, OmputerHostControllers>();
+
+export function bindOmputerHost(session: AgentSession, controllers: OmputerHostControllers): void {
+	hosts.set(session, controllers);
+	session.addDisposer(() => hosts.delete(session));
+}
+
+export function getOmputerHost(session: AgentSession): OmputerHostControllers | undefined {
+	return hosts.get(session);
+}
