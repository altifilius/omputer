+import { afterEach, describe, expect, test } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { readRpcSubagentTranscript } from "@oh-my-pi/pi-coding-agent/modes/rpc/rpc-subagents";
+
+const pageBytes = 256 * 1024;
+const maxRecordBytes = 2 * 1024 * 1024;
+const tempPaths: string[] = [];
+
+afterEach(async () => {
+	for (const dir of tempPaths.splice(0)) await fs.rm(dir, { recursive: true, force: true });
+});
+
+async function transcript(content: string | Buffer): Promise<string> {
+	const dir = await fs.mkdtemp(path.join(os.tmpdir(), "omputer-child-transcript-"));
+	tempPaths.push(dir);
+	const sessionFile = path.join(dir, "child.jsonl");
+	await fs.writeFile(sessionFile, content);
+	return sessionFile;
+}
+
+function messageLine(id: string, text: string): string {
+	return `${JSON.stringify({
+		type: "message",
+		id,
+		parentId: null,
+		timestamp: "2026-10-18T00:00:00.000Z",
+		message: { role: "user", content: [{ type: "text", text }] },
+	})}\n`;
+}
+
+function entryOfBytes(id: string, bytes: number): string {
+	const empty = messageLine(id, "");
+	return messageLine(id, "x".repeat(bytes - Buffer.byteLength(empty)));
+}
+
+describe("bounded child transcript pages", () => {
+	test("reads multiple pages with exact cursors and no omitted or duplicate UTF-8 records", async () => {
+		const prefix = messageLine("first", "hello");
+		const emptyUnicode = messageLine("unicode", "🙂日本語");
+		const textOffset = Buffer.byteLength(emptyUnicode.slice(0, emptyUnicode.indexOf("🙂")));
+		// The ordinary page ends halfway through the emoji, not on a UTF-8 boundary.
+		const padding = pageBytes - Buffer.byteLength(prefix) - textOffset - 2;
+		const unicode = messageLine("unicode", `${"x".repeat(padding)}🙂日本語`);
+		const lines = [prefix, unicode, ...Array.from({ length: 24 }, (_, i) => messageLine(`m${i}`, "é界🙂".repeat(8_000)))];
+		const content = lines.join("");
+		const sessionFile = await transcript(content);
+		const expected = lines.map(line => JSON.parse(line));
+		const entries: unknown[] = [];
+		let cursor = 0;
+		let pages = 0;
+		for (;;) {
+			const result = await readRpcSubagentTranscript(sessionFile, cursor);
+			expect(result.fromByte).toBe(cursor);
+			expect(result.reset).toBe(false);
+			expect(result.nextByte).toBeGreaterThan(cursor);
+			expect(result.nextByte - cursor).toBeLessThanOrEqual(pageBytes);
+			expect(Buffer.from(content).subarray(cursor, result.nextByte).toString("utf8").endsWith("\n")).toBe(true);
+			entries.push(...result.entries);
+			expect(result.messages).toEqual(result.entries.filter(entry => entry.type === "message").map(entry => entry.message));
+			cursor = result.nextByte;
+			pages++;
+			if (!result.hasMore) break;
+			expect(pages).toBeLessThan(lines.length + 1);
+		}
+		expect(pages).toBeGreaterThan(2);
+		expect(entries).toEqual(expected);
+		expect(cursor).toBe(Buffer.byteLength(content));
+		const end = await readRpcSubagentTranscript(sessionFile, cursor);
+		expect(end.entries).toEqual([]);
+		expect(end.nextByte).toBe(cursor);
+		expect(end.hasMore).toBe(false);
+	});
+
+	test("does not consume a partial UTF-8 tail and reads it once completed", async () => {
+		const first = messageLine("first", "complete");
+		const last = messageLine("last", "🙂 still writing");
+		const bytes = Buffer.from(last);
+		const cut = bytes.indexOf(Buffer.from("🙂")) + 2;
+		const sessionFile = await transcript(Buffer.concat([Buffer.from(first), bytes.subarray(0, cut)]));
+		const page = await readRpcSubagentTranscript(sessionFile);
+		expect(page.entries.map(entry => entry.id)).toEqual(["first"]);
+		expect(page.nextByte).toBe(Buffer.byteLength(first));
+		expect(page.hasMore).toBe(false);
+		const pending = await readRpcSubagentTranscript(sessionFile, page.nextByte);
+		expect(pending.entries).toEqual([]);
+		expect(pending.nextByte).toBe(page.nextByte);
+		expect(pending.hasMore).toBe(false);
+		await fs.appendFile(sessionFile, bytes.subarray(cut));
+		const completed = await readRpcSubagentTranscript(sessionFile, pending.nextByte);
+		expect(completed.entries).toEqual([JSON.parse(last)]);
+		expect(completed.nextByte).toBe(Buffer.byteLength(first) + bytes.length);
+		expect(completed.hasMore).toBe(false);
+	});
+
+	test("normalizes fromByte, resumes at exact records, and resets only beyond a truncated file", async () => {
+		const first = messageLine("first", "a");
+		const second = messageLine("second", "b");
+		const sessionFile = await transcript(first + second);
+		const cursor = Buffer.byteLength(first);
+		const resumed = await readRpcSubagentTranscript(sessionFile, cursor + 0.9);
+		expect(resumed.fromByte).toBe(cursor);
+		expect(resumed.entries).toEqual([JSON.parse(second)]);
+		expect(resumed.reset).toBe(false);
+		for (const offset of [-100, Number.NaN, Number.POSITIVE_INFINITY]) {
+			const normalized = await readRpcSubagentTranscript(sessionFile, offset);
+			expect(normalized.fromByte).toBe(0);
+			expect(normalized.entries).toHaveLength(2);
+			expect(normalized.reset).toBe(false);
+		}
+		await fs.writeFile(sessionFile, first);
+		const reset = await readRpcSubagentTranscript(sessionFile, resumed.nextByte);
+		expect(reset.fromByte).toBe(0);
+		expect(reset.nextByte).toBe(cursor);
+		expect(reset.reset).toBe(true);
+		expect(reset.entries).toEqual([JSON.parse(first)]);
+		expect(reset.hasMore).toBe(false);
+	});
+
+	test("advances past a lone large record and preserves complete following records", async () => {
+		const large = entryOfBytes("large", pageBytes + 17);
+		const following = messageLine("following", "next page");
+		const sessionFile = await transcript(large + following);
+		const first = await readRpcSubagentTranscript(sessionFile);
+		expect(first.entries).toEqual([JSON.parse(large)]);
+		expect(first.nextByte).toBe(Buffer.byteLength(large));
+		expect(first.hasMore).toBe(true);
+		const next = await readRpcSubagentTranscript(sessionFile, first.nextByte);
+		expect(next.entries).toEqual([JSON.parse(following)]);
+		expect(next.hasMore).toBe(false);
+	});
+
+	test("accepts the exact single-record bound and explicitly rejects larger records without skipping", async () => {
+		const exact = entryOfBytes("exact", maxRecordBytes);
+		const sessionFile = await transcript(exact);
+		const accepted = await readRpcSubagentTranscript(sessionFile);
+		expect(accepted.nextByte).toBe(maxRecordBytes);
+		expect(accepted.entries).toEqual([JSON.parse(exact)]);
+		expect(accepted.hasMore).toBe(false);
+		const prefix = messageLine("first", "still readable");
+		await fs.writeFile(sessionFile, prefix + entryOfBytes("oversize", maxRecordBytes + 1));
+		const page = await readRpcSubagentTranscript(sessionFile);
+		expect(page.entries).toEqual([JSON.parse(prefix)]);
+		expect(page.nextByte).toBe(Buffer.byteLength(prefix));
+		expect(page.hasMore).toBe(true);
+		await expect(readRpcSubagentTranscript(sessionFile, page.nextByte)).rejects.toThrow(
+			`Subagent transcript record at byte ${page.nextByte} exceeds ${maxRecordBytes} bytes`,
+		);
+		await fs.writeFile(sessionFile, "x".repeat(maxRecordBytes + 1));
+		await expect(readRpcSubagentTranscript(sessionFile)).rejects.toThrow(
+			`Subagent transcript record at byte 0 exceeds ${maxRecordBytes} bytes`,
+		);
+	});
+
+	test("returns a bounded empty result for an absent file without resetting its caller cursor", async () => {
+		const sessionFile = await transcript("");
+		await fs.unlink(sessionFile);
+		expect(await readRpcSubagentTranscript(sessionFile, 27)).toEqual({
+			sessionFile,
+			fromByte: 27,
+			nextByte: 27,
+			reset: false,
+			hasMore: false,
+			entries: [],
+			messages: [],
+		});
+	});
+});
