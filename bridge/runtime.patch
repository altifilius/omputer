+	async #initializeLinux(): Promise<void> {
+		if (this.#clockTicks !== undefined && this.#bootTime !== undefined) return;
+		const [auxv, stat] = await Promise.all([fs.readFile("/proc/self/auxv"), fs.readFile("/proc/stat", "utf8")]);
