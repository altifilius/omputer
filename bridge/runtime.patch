+/** RPC uses the same state, guards, tool partition, model policy and approval artifact as the TUI. */
+export class HeadlessPlanController {
+	#previous: PlanSnapshot | undefined;
+	constructor(readonly session: AgentSession) {}
+
+	async reconcile(): Promise<void> {
