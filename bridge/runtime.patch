--- /dev/null
+++ b/packages/coding-agent/examples/extensions/resource-queue/queue.test.ts
@@ -0,0 +1,287 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createInterface } from "node:readline";
+import { Readable } from "node:stream";
+import { AsyncJobManager } from "@oh-my-pi/pi-coding-agent/async/job-manager";
+import { diagnostic } from "./index";
+import { FamilyActivity, ResourceQueue, type Pressure } from "./queue";
+
+const healthy: Pressure = {
+	total: 16 * 1024 ** 3,
+	available: 8 * 1024 ** 3,
+	swapUsedRatio: 0.1,
+	cpuBusy: 0,
+	memoryStall: 0,
+};
+
+function temporaryQueue() {
+	const directory = mkdtempSync(join(tmpdir(), "omp-queue-test-"));
+	const path = join(directory, "queue.sqlite");
+	const queue = new ResourceQueue(path);
+	return {
+		path,
+		queue,
+		close() {
+			queue.close();
+			rmSync(directory, { recursive: true });
+		},
+	};
+}
+
+test("memory and swap guards hold the queue until resources recover", () => {
+	const fixture = temporaryQueue();
+	try {
+		for (const pressure of [
+			{ ...healthy, available: 3 * 1024 ** 3 },
+			{ ...healthy, available: 5 * 1024 ** 3, swapUsedRatio: 0.75 },
+			{ ...healthy, memoryStall: 5 },
+			{ ...healthy, available: Number.NaN },
+			{ ...healthy, total: Number.POSITIVE_INFINITY },
+		]) {
+			expect(fixture.queue.poll(pressure).admitted).toBe(false);
+			expect(fixture.queue.poll(healthy).admitted).toBe(true);
+			fixture.queue.release();
+		}
+		expect(fixture.queue.poll({ ...healthy, available: 4 * 1024 ** 3 }).admitted).toBe(true);
+		fixture.queue.release();
+		expect(fixture.queue.poll({ ...healthy, total: 8 * 1024 ** 3, available: 3 * 1024 ** 3 }).admitted).toBe(true);
+	} finally {
+		fixture.close();
+	}
+});
+
+test("admitted batches and separately loaded children share the family until every participant drains", () => {
+	const fixture = temporaryQueue();
+	const child = new ResourceQueue(fixture.path);
+	try {
+		expect(fixture.queue.poll(healthy).admitted).toBe(true);
+		expect(child.poll({ ...healthy, available: 0 }).admitted).toBe(true);
+		fixture.queue.release();
+		// The root releasing its own claim must not release a live child's claim.
+		expect(fixture.queue.poll({ ...healthy, available: 0 }).admitted).toBe(true);
+		fixture.queue.release();
+		child.release();
+		expect(fixture.queue.poll({ ...healthy, available: 0 }).admitted).toBe(false);
+		expect(fixture.queue.poll(healthy).admitted).toBe(true);
+	} finally {
+		child.close();
+		fixture.close();
+	}
+});
+
+test("CPU pressure alone cannot strand the only waiting family", () => {
+	const fixture = temporaryQueue();
+	try {
+		expect(fixture.queue.poll({ ...healthy, cpuBusy: 99 }).admitted).toBe(true);
+	} finally {
+		fixture.close();
+	}
+});
+
+test("four live families hand off FIFO; cancelled waiters and dead owners cannot block the head", async () => {
+	const directory = mkdtempSync(join(tmpdir(), "omp-queue-test-"));
+	const path = join(directory, "queue.sqlite");
+	const script = `
+		import { ResourceQueue } from ${JSON.stringify(join(import.meta.dir, "queue.ts"))};
+		import { createInterface } from 'node:readline';
+		const queue = new ResourceQueue(process.env.QUEUE_DB);
+		createInterface({ input: process.stdin }).on('line', command => {
+			if (command.startsWith('{')) console.log(JSON.stringify(queue.poll(JSON.parse(command))));
+			if (command === 'release') { queue.release(); console.log('released'); }
+		});
+		console.log('ready');
+	`;
+	const workers = Array.from({ length: 4 }, () =>
+		Bun.spawn([process.execPath, "-e", script], {
+			env: { ...process.env, QUEUE_DB: path },
+			stdin: "pipe",
+			stdout: "pipe",
+			stderr: "inherit",
+		}),
+	);
+	const lines = workers.map(worker =>
+		createInterface({ input: Readable.fromWeb(worker.stdout) })[Symbol.asyncIterator](),
+	);
+	const receive = async (index: number) => {
+		const result = await lines[index].next();
+		if (result.done) throw new Error(`Queue worker ${index} exited before replying`);
+		return result.value;
+	};
+	const poll = async (index: number, pressure = healthy) => {
+		workers[index].stdin.write(`${JSON.stringify(pressure)}\n`);
+		const state: unknown = JSON.parse(await receive(index));
+		if (
+			!state ||
+			typeof state !== "object" ||
+			!("position" in state) ||
+			typeof state.position !== "number" ||
+			!("admitted" in state) ||
+			typeof state.admitted !== "boolean"
+		)
+			throw new Error("Invalid queue worker response");
+		return state;
+	};
+	try {
+		for (let index = 0; index < workers.length; index++) expect(await receive(index)).toBe("ready");
+		const busyCPU = { ...healthy, cpuBusy: 95 };
+		expect((await poll(0, busyCPU)).admitted).toBe(true);
+		for (let index = 1; index < workers.length; index++) {
+			const state = await poll(index, busyCPU);
+			expect(state.admitted).toBe(false);
+			expect(state.position).toBe(index + 1);
+		}
+		expect((await poll(1)).admitted).toBe(false);
+		for (let index = 0; index < workers.length; index++) {
+			workers[index].stdin.write("release\n");
+			expect(await receive(index)).toBe("released");
+			if (index + 1 < workers.length) expect((await poll(index + 1, busyCPU)).admitted).toBe(true);
+		}
+		expect((await poll(0)).admitted).toBe(true);
+		for (let index = 1; index < workers.length; index++) expect((await poll(index)).admitted).toBe(false);
+		workers[1].stdin.write("release\n");
+		expect(await receive(1)).toBe("released");
+		workers[0].kill();
+		await workers[0].exited;
+		expect((await poll(3)).admitted).toBe(false);
+		expect((await poll(2, busyCPU)).admitted).toBe(true);
+		expect((await poll(3)).admitted).toBe(false);
+		workers[2].stdin.write("release\n");
+		expect(await receive(2)).toBe("released");
+		expect((await poll(3, busyCPU)).admitted).toBe(true);
+	} finally {
+		for (const worker of workers) worker.kill();
+		await Promise.all(workers.map(worker => worker.exited));
+		for (const iterator of lines) await iterator.return?.();
+		rmSync(directory, { recursive: true });
+	}
+}, 15_000);
+
+test("cancellation keeps admission until all six job bodies settle, including hidden foreground work", async () => {
+	const manager = new AsyncJobManager({});
+	const idle = Promise.withResolvers<void>();
+	const activity = new FamilyActivity(manager, () => idle.resolve());
+	const bodies = Array.from({ length: 6 }, () => Promise.withResolvers<string>());
+	activity.start("Main:batch:bash", "Main");
+	const ids = bodies.map((body, index) =>
+		manager.register("bash", `job ${index}`, () => body.promise, {
+			ownerId: "Main",
+			foreground: index === 5,
+		}),
+	);
+	let released = false;
+	void idle.promise.then(() => {
+		released = true;
+	});
+	try {
+		for (const id of ids) manager.cancel(id);
+		expect(manager.getAllJobs()).toHaveLength(5);
+		expect(manager.getAllJobs().every(job => job.status === "cancelled" && job.endTime === undefined)).toBe(true);
+		activity.finish("Main:batch:bash");
+		for (let index = 0; index < bodies.length - 1; index++) bodies[index].resolve("settled");
+		await Promise.all(ids.slice(0, -1).map(id => manager.getJob(id)!.promise));
+		expect(released).toBe(false);
+		bodies[5].resolve("foreground cleanup settled");
+		await idle.promise;
+		expect(released).toBe(true);
+	} finally {
+		activity.stop();
+		for (const body of bodies) body.resolve("cleanup");
+		await manager.dispose({ timeoutMs: 100 });
+	}
+});
+
+test("an unstarted batch and nested child work cannot lose admission to an earlier drain snapshot", async () => {
+	const manager = new AsyncJobManager({});
+	const idle = Promise.withResolvers<void>();
+	let releases = 0;
+	const activity = new FamilyActivity(manager, () => {
+		releases++;
+		idle.resolve();
+	});
+	const child = Promise.withResolvers<string>();
+	activity.start("Main:first:eval", "Main");
+	activity.start("Main:second:bash", "Main");
+	activity.finish("Main:first:eval");
+	await Promise.resolve();
+	expect(releases).toBe(0);
+	activity.finish("Main:second:bash");
+	// Arrive while the previous drain is between snapshots.
+	activity.start("Child:nested:bash", "Child");
+	manager.register("bash", "nested", () => child.promise, { ownerId: "Child", foreground: true });
+	activity.finishOwner("Child");
+	await Promise.resolve();
+	expect(releases).toBe(0);
+	try {
+		child.resolve("done");
+		await idle.promise;
+		expect(releases).toBe(1);
+	} finally {
+		activity.stop();
+		child.resolve("cleanup");
+		await manager.dispose({ timeoutMs: 100 });
+	}
+});
+
+test("diagnostic bypass accepts literal reads, not composed commands or arbitrary files", () => {
+	for (const command of [
+		"ps -eo pid,comm",
+		"free -h",
+		"uptime",
+		"cat /proc/meminfo /proc/pressure/memory",
+		"systemctl --user show --property=MemoryCurrent session.slice",
+	]) {
+		expect(diagnostic(command)).toBe(true);
+	}
+	for (const command of [
+		"ps; sleep 30",
+		"free -h && make",
+		"cat /etc/passwd",
+		"python -c 1",
+		"systemctl restart service",
+		"uptime\nsleep 30",
+		"ps $(make)",
+	]) {
+		expect(diagnostic(command)).toBe(false);
+	}
+});
+
+test("manager loss and session shutdown never imply settlement", async () => {
+	let releases = 0;
+	const failed = Promise.withResolvers<void>();
+	const activity = new FamilyActivity(
+		{
+			waitForAll: () => failed.promise,
+			waitForOwnerJobs: async () => true,
+		},
+		() => {
+			releases++;
+		},
+	);
+	activity.start("Main:call:bash", "Main");
+	activity.finish("Main:call:bash");
+	failed.reject(new Error("worker disconnected"));
+	await activity.check();
+	expect(releases).toBe(0);
+	await activity.check();
+	expect(releases).toBe(0);
+
+	const cleanup = Promise.withResolvers<void>();
+	const stopping = new FamilyActivity(
+		{
+			waitForAll: () => cleanup.promise,
+			waitForOwnerJobs: async () => true,
+		},
+		() => {
+			releases++;
+		},
+	);
+	stopping.start("Main:exit:bash", "Main");
+	stopping.finishOwner("Main");
+	const drain = stopping.check();
+	stopping.stop();
+	cleanup.resolve();
+	await drain;
+	expect(releases).toBe(0);
+});
diff --git a/packages/coding-agent/examples/extensions/resource-queue/queue.ts b/packages/coding-agent/examples/extensions/resource-queue/queue.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/examples/extensions/resource-queue/queue.ts
@@ -0,0 +1,244 @@
+import { Database } from "bun:sqlite";
+import { randomUUID } from "node:crypto";
+import { mkdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, join } from "node:path";
+
+export interface Pressure {
+	available: number;
+	total: number;
+	swapUsedRatio: number;
+	cpuBusy: number;
+	memoryStall: number;
+}
+
+export interface QueueState {
+	position: number;
+	admitted: boolean;
+	reason: string;
+}
+
+interface Entry {
+	id: number;
+	owner: string;
+	pid: number;
+	started: string;
+	active: number;
+}
+
+export function processStart(pid: number): string | undefined {
+	try {
+		const fields = readFileSync(`/proc/${pid}/stat`, "utf8").split(") ").slice(1).join(") ").trim().split(/\s+/);
+		if (fields[0] === "Z") return undefined;
+		return fields[19];
+	} catch (error) {
+		if (error instanceof Error && "code" in error && error.code === "ENOENT") return undefined;
+		throw error;
+	}
+}
+
+export function samplePressure(): Pressure {
+	const memory: Record<string, number> = {};
+	for (const match of readFileSync("/proc/meminfo", "utf8").matchAll(/^(\w+):\s+(\d+) kB/gm)) {
+		memory[match[1]] = Number(match[2]) * 1024;
+	}
+	const total = memory.MemTotal;
+	const available = memory.MemAvailable;
+	const swapTotal = memory.SwapTotal;
+	const swapFree = memory.SwapFree;
+	if (!total || available === undefined || swapTotal === undefined || swapFree === undefined) {
+		throw new Error("Cannot read Linux memory availability; work remains queued");
+	}
+	const average = (path: string, category: string): number => {
+		const value = readFileSync(path, "utf8").match(new RegExp(`^${category} avg10=([0-9.]+)`, "m"));
+		if (!value) throw new Error(`Cannot read ${path}; work remains queued`);
+		return Number(value[1]);
+	};
+	return {
+		total,
+		available,
+		swapUsedRatio: swapTotal ? (swapTotal - swapFree) / swapTotal : 0,
+		cpuBusy: average("/proc/pressure/cpu", "some"),
+		memoryStall: average("/proc/pressure/memory", "some"),
+	};
+}
+
+export function admissionReason(pressure: Pressure): string {
+	if (
+		!Number.isFinite(pressure.total) ||
+		pressure.total <= 0 ||
+		!Number.isFinite(pressure.available) ||
+		pressure.available < 0 ||
+		pressure.available > pressure.total ||
+		!Number.isFinite(pressure.swapUsedRatio) ||
+		pressure.swapUsedRatio < 0 ||
+		pressure.swapUsedRatio > 1 ||
+		!Number.isFinite(pressure.memoryStall) ||
+		pressure.memoryStall < 0
+	)
+		return "Waiting for valid memory pressure data";
+	const reserve = Math.max(3 * 1024 ** 3, pressure.total * 0.25);
+	if (pressure.available < reserve) return "Waiting for available RAM";
+	if (pressure.swapUsedRatio >= 0.75 && pressure.available < pressure.total * 0.4) {
+		return "Waiting for swap pressure to fall";
+	}
+	if (pressure.memoryStall >= 5) return "Waiting for memory pressure to fall";
+	return "";
+}
+
+function defaultQueuePath(): string {
+	const uid = process.getuid?.();
+	if (process.platform !== "linux" || uid === undefined) throw new Error("Resource queue requires Linux");
+	return join(process.env.XDG_RUNTIME_DIR ?? `/run/user/${uid}`, "omp-resource-queue", "queue.sqlite");
+}
+
+/** One process family runs until its finite work settles; CPU load cannot stall an empty queue. */
+export class ResourceQueue {
+	private readonly db: Database;
+	private readonly owner: string;
+	private readonly participant = randomUUID();
+	private readonly pid: number;
+	private readonly started: string;
+
+	constructor(path = defaultQueuePath()) {
+		const uid = process.getuid?.();
+		if (process.platform !== "linux" || uid === undefined) throw new Error("Resource queue requires Linux");
+		const directory = dirname(path);
+		mkdirSync(directory, { recursive: true, mode: 0o700 });
+		const info = statSync(directory);
+		if (info.uid !== uid || (info.mode & 0o077) !== 0) {
+			throw new Error("OMP resource queue directory must be owner-only");
+		}
+		this.pid = process.pid;
+		this.started = processStart(this.pid) ?? "";
+		if (!this.started) throw new Error("Cannot establish OMP process identity");
+		this.owner = `${this.pid}:${this.started}`;
+		this.db = new Database(path, { create: true, strict: true });
+		this.db.exec("PRAGMA busy_timeout=5000;");
+		this.db.exec(
+			"CREATE TABLE IF NOT EXISTS queue (id INTEGER PRIMARY KEY AUTOINCREMENT, owner TEXT NOT NULL UNIQUE, pid INTEGER NOT NULL, started TEXT NOT NULL, active INTEGER NOT NULL DEFAULT 0)",
+		);
+		// Factories are rebound per session, including in pooled worker threads.
+		// Each holds its own claim; one child's idle/shutdown cannot release siblings.
+		this.db.exec("CREATE TABLE IF NOT EXISTS participants (id TEXT PRIMARY KEY, owner TEXT NOT NULL)");
+	}
+
+	private prune(): void {
+		const rows = this.db.query<Entry, []>("SELECT * FROM queue").all();
+		const remove = this.db.query("DELETE FROM queue WHERE owner = ?");
+		for (const row of rows) if (processStart(row.pid) !== row.started) remove.run(row.owner);
+		this.db.exec("DELETE FROM participants WHERE owner NOT IN (SELECT owner FROM queue)");
+	}
+
+	poll(pressure?: Pressure): QueueState {
+		return this.db
+			.transaction(() => {
+				this.prune();
+				this.db
+					.query("INSERT OR IGNORE INTO queue(owner, pid, started) VALUES (?, ?, ?)")
+					.run(this.owner, this.pid, this.started);
+				this.db
+					.query("INSERT OR IGNORE INTO participants(id, owner) VALUES (?, ?)")
+					.run(this.participant, this.owner);
+				const entries = this.db.query<Entry, []>("SELECT * FROM queue ORDER BY id").all();
+				// Rechecking an acquired lease can deadlock an unstarted tool batch.
+				if (entries.some(row => row.owner === this.owner && row.active)) {
+					return { position: 0, admitted: true, reason: "" };
+				}
+				const active = entries.filter(row => row.active).length;
+				const pending = entries.filter(row => !row.active);
+				const position = pending.findIndex(row => row.owner === this.owner) + 1;
+				const reason = active
+					? "Waiting for another OMP process family"
+					: position > 1
+						? "Waiting for an earlier resource request"
+						: admissionReason(pressure ?? samplePressure());
+				if (!reason) this.db.query("UPDATE queue SET active = 1 WHERE owner = ?").run(this.owner);
+				return { position: position + active, admitted: !reason, reason };
+			})
+			.immediate();
+	}
+
+	release(): void {
+		this.db
+			.transaction(() => {
+				this.db.query("DELETE FROM participants WHERE id = ?").run(this.participant);
+				this.db
+					.query("DELETE FROM queue WHERE owner = ? AND NOT EXISTS (SELECT 1 FROM participants WHERE owner = ?)")
+					.run(this.owner, this.owner);
+			})
+			.immediate();
+	}
+
+	close({ release = true }: { release?: boolean } = {}): void {
+		if (release) this.release();
+		this.db.close();
+	}
+}
+
+/** Include hidden foreground rows and cancelled jobs still unwinding, not just visible snapshots. */
+export interface JobSettlement {
+	waitForAll(): Promise<void>;
+	waitForOwnerJobs(ownerId: string): Promise<boolean>;
+}
+
+export class FamilyActivity {
+	private readonly calls = new Set<string>();
+	private readonly owners = new Set<string>();
+	private revision = 0;
+	private draining: Promise<void> | undefined;
+	private stopped = false;
+
+	constructor(
+		private readonly jobs: JobSettlement,
+		private readonly onIdle: () => void,
+	) {}
+
+	start(key: string, ownerId: string): void {
+		this.revision++;
+		this.calls.add(key);
+		this.owners.add(ownerId);
+	}
+
+	finish(key: string): void {
+		this.calls.delete(key);
+		this.check();
+	}
+
+	finishOwner(ownerId: string): void {
+		for (const key of this.calls) if (key.startsWith(`${ownerId}:`)) this.calls.delete(key);
+		this.check();
+	}
+
+	stop(): void {
+		this.stopped = true;
+	}
+
+	check(): Promise<void> | undefined {
+		if (this.stopped || this.calls.size) return;
+		if (this.draining) return this.draining;
+		const revision = this.revision;
+		this.draining = (async () => {
+			try {
+				await this.jobs.waitForAll();
+				// Owner barriers re-snapshot after settlement and include foreground rows
+				// registered by nested work while the first manager snapshot was waiting.
+				for (const owner of this.owners) {
+					if (!(await this.jobs.waitForOwnerJobs(owner))) throw new Error("Owner jobs did not settle");
+				}
+				await this.jobs.waitForAll();
+				if (!this.stopped && !this.calls.size && revision === this.revision) {
+					this.owners.clear();
+					this.onIdle();
+				}
+			} catch {
+				// A disconnected worker or unavailable manager cannot prove settlement.
+				// Retain its claim until process exit; never turn an error into admission.
+				this.stopped = true;
+			} finally {
+				this.draining = undefined;
+				if (!this.stopped && revision !== this.revision) this.check();
+			}
+		})();
+		return this.draining;
+	}
+}
