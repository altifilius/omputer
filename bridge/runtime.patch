+
+test("queue editing is atomic, retains images and rejects consumed/custom targets", () => {
+	const image = { type: "image" as const, data: "AA==", mimeType: "image/png" };
+	session.agent.followUp({ role: "user", content: [{ type: "text", text: "old" }, image], timestamp: 1 });
+	expect(session.editQueuedMessage("old", "followUp", "/literal replacement")).toBe(true);
+	expect(session.agent.peekFollowUpQueue()[0]).toMatchObject({ content: [{ type: "text", text: "/literal replacement" }, image] });
+	expect(session.editQueuedMessage("old", "followUp", "no replay")).toBe(false);
+	session.agent.followUp({ role: "custom", customType: "skill", content: "expanded", display: true, attribution: "user", timestamp: 2 });
+	expect(() => session.editQueuedMessage("expanded", "followUp", "unsafe")).toThrow("Remove and re-author");
+});
+
+test("real plan entry/cancel restores the prior mode and never invokes a provider", async () => {
+	const tools = session.getEnabledToolNames(); const model = session.model; const effort = session.configuredThinkingLevel();
+	await control("plan.enter");
+	expect(session.getPlanModeState()?.enabled).toBe(true);
+	expect(session.peekPlanProposalHandler()).toBeDefined();
+	await expect(control("goal.create", { objective: "not during plan" })).rejects.toThrow("Exit plan mode");
+	await expect(control("plan.approve", { revision: "unreviewed" })).rejects.toMatchObject({ code: "stale_plan" });
+	await control("plan.cancel");
+	expect(session.getPlanModeState()).toBeUndefined();
+	expect(session.peekPlanProposalHandler()).toBeUndefined();
+	expect(session.getEnabledToolNames()).toEqual(tools);
+	expect(session.model).toEqual(model); expect(session.configuredThinkingLevel()).toEqual(effort);
+	expect(calls).toBe(0);
+});
+
+test("tree controls reject unknown entries and stale journal identities without writing", async () => {
+	await expect(control("branch", { entryId: "absent" })).rejects.toMatchObject({ code: "stale_entry" });
+	await expect(controls.execute("session.control", { control: "fork", arguments: {}, confirmed: true, expectedJournalId: "different-journal" }, "op", () => {})).rejects.toMatchObject({ code: "stale_identity" });
+	expect(calls).toBe(0);
+});
+
+test("extension failures propagate and command aliases cannot shadow builtins", async () => {
+	const catalog = await controls.catalog();
+	expect((catalog.commands as Array<{ id: string }>).some(command => command.id === "extension:models")).toBe(false);
