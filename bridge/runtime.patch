+function stat(state = "S"): string {
+	const fields = Array.from({ length: 22 }, () => "0");
+	fields[0] = state;
+	fields[1] = "41";
+	fields[11] = "120";
+	fields[12] = "23";
+	fields[19] = "4567";
+	return `42 (worker ) name with (parens)) ${fields.join(" ")}`;
