+			fixture.setProcesses([proc(process.pid, 1, 100), { ...child, ppid: 1 }]);
+			expect((await fixture.sample()).processCount).toBe(2);
+			fixture.setSession("other");
+			expect((await fixture.sample()).processCount).toBe(1);
+			fixture.setSession("main");
+			expect((await fixture.sample()).processCount).toBe(2);
