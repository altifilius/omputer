@@ -0,0 +1,368 @@
+import { LoginCancelledError } from "@oh-my-pi/pi-ai/error";
+import { getOAuthProviders, type OAuthPrompt } from "@oh-my-pi/pi-ai/oauth";
+import { parseConfiguredThinkingLevel } from "@oh-my-pi/pi-tui/thinking";
+import { all, lookup, type AnySetting } from "../config/registry";
+import { cfgDefaultThinkingLevel } from "./settings";
+import type { ExtensionContext, ExtensionUIDialogOptions } from "../extensibility/extensions/types";
+import { cfgSkillsRegistryUrl } from "../extensibility/settings";
+import { SkillshareClient, parseSkillSpec } from "../skillshare/client";
+import {
+	formatScriptApproval, installSkillPackages, listInstalledSkills, updateSkillPackages,
+	type SkillInstallHooks,
+} from "../skillshare/installer";
+import { listLogoutAccounts, logoutCredential } from "../slash-commands/helpers/logout";
+import { parseCommandArgs } from "../utils/command-args";
+import type { AgentSession } from "./agent-session";
+import type { OmputerCommand } from "./omputer-controls";
+
+type Json = Record<string, unknown>;
+type Args = string | Json;
+type SecretUI = ExtensionContext["ui"] & {
+	inputSecret?(title: string, placeholder?: string, options?: ExtensionUIDialogOptions): Promise<string | undefined>;
+	confirmPrivate?(title: string, message: string, options?: ExtensionUIDialogOptions): Promise<boolean>;
+};
+
+function fail(message: string, code = "invalid_arguments"): never {
+	throw Object.assign(new Error(message), { code });
+}
+function fields(args: Json, allowed: readonly string[]): void {
+	if (Object.keys(args).some(key => !allowed.includes(key))) fail("Unknown administration argument");
+}
+function text(args: Json, key: string): string {
+	const value = args[key];
+	if (typeof value !== "string" || !value.trim()) fail(`${key} is required`);
+	return value;
+}
+function scope(args: Json): "session" | "saved" {
+	if (args.scope !== "session" && args.scope !== "saved") fail("Explicit scope must be session or saved");
+	return args.scope;
+}
+function settingFor(args: Json): AnySetting {
+	const setting = lookup(text(args, "key"));
+	if (!setting) fail("Unknown registry setting");
+	return setting;
+}
+
+/** Parse only literal argv; values never pass through a shell. Mutating scopes never default. */
+export function parseOmputerAdminArgs(name: string, raw: Args): Json {
+	if (typeof raw === "string" && raw.trimStart().startsWith("{")) {
+		try { raw = JSON.parse(raw); } catch { fail("Invalid administration JSON"); }
+	}
+	if (typeof raw !== "string") {
+		if (!raw || Array.isArray(raw) || Object.getPrototypeOf(raw) !== Object.prototype) fail("Administration arguments must be a plain object");
+		if (Object.keys(raw).some(key => ["__proto__", "constructor", "prototype"].includes(key))) fail("Invalid administration argument key");
+		return { ...raw };
+	}
+	const tokens = parseCommandArgs(raw, { strict: true });
+	if (name === "settings") {
+		const action = tokens.shift() || "list";
+		if (action === "list") {
+			if (tokens.length) fail("Usage: /settings list");
+			return { action };
+		}
+		const key = tokens.shift();
+		if (!key) fail("Setting key is required");
+		if (action === "get") {
+			if (tokens.length) fail("Usage: /settings get <key>");
+			return { action, key };
+		}
+		if (action !== "set" && action !== "reset") fail("Unknown settings action");
+		const index = tokens.indexOf("--scope");
+		if (index < 0 || index + 1 >= tokens.length) fail("Explicit --scope session|saved is required");
+		const selectedScope = tokens[index + 1];
+		tokens.splice(index, 2);
+		if (tokens.some(token => token.startsWith("--"))) fail("Unknown settings option");
+		const args: Json = { action, key, scope: selectedScope };
+		scope(args);
+		if (action === "reset") {
+			if (tokens.length) fail("Reset does not take a value");
+		} else if (tokens.length) {
+			const setting = settingFor(args);
+			if (setting.isCredential) fail("Credential values must use secure UI input");
+			args.value = setting.parse(tokens.join(" "));
+		}
+		return args;
+	}
+	if (name === "login" || name === "setup" || name === "logout") {
+		if (!tokens.length || tokens[0] === "providers") {
+			if (tokens.length > 1) fail("Unexpected provider-list arguments");
+			return { action: "providers" };
+		}
+		if (tokens[0] === "accounts") {
+			if (tokens.length !== 2) fail("Usage: accounts <provider>");
+			return { action: "accounts", providerId: tokens[1] };
+		}
+		if (name !== "logout") {
+			if (tokens.length !== 1 || tokens[0]!.startsWith("-")) fail("Usage: /login <provider>");
+			return { action: "login", providerId: tokens[0] };
+		}
+		if (tokens.length !== 2 || !/^[1-9]\d*$/.test(tokens[1]!)) fail("Usage: /logout <provider> <credentialId>");
+		return { action: "logout", providerId: tokens[0], credentialId: Number(tokens[1]) };
+	}
+	if (name === "skills") {
+		const action = tokens.shift() || "installed";
+		if (action === "installed") {
+			if (tokens.length) fail("Usage: /skills installed");
+			return { action };
+		}
+		if (action === "search") {
+			if (!tokens.length || tokens.some(token => token.startsWith("-"))) fail("Usage: /skills search <query>");
+			return { action, query: tokens.join(" ") };
+		}
+		if (action !== "install" && action !== "update") fail("Unknown skills action");
+		const index = tokens.indexOf("--scope");
+		if (index < 0 || !["project", "user"].includes(tokens[index + 1]!)) fail("Explicit --scope project|user is required");
+		const global = tokens[index + 1] === "user";
+		tokens.splice(index, 2);
+		if (tokens.some(token => token.startsWith("-"))) fail("Unknown skills option; --yes is not supported");
+		return { action, targets: tokens, global };
+	}
+	return fail("Unknown administration command");
+}
+
+/** All mutations require the caller's revision/identity/confirmation fence. No credentials enter output. */
+export class OmputerAdmin {
+	constructor(readonly session: AgentSession, readonly ctx: ExtensionContext) {}
+
+	commands(): OmputerCommand[] {
+		return [
+			{ name: "settings", description: "Read and change typed local settings", inputHint: "list | get <key> | set <key> --scope session|saved [value] | reset <key> --scope session|saved", risk: "change" as const, actions: ["list", "get", "set", "reset"] },
+			{ name: "setup", description: "Set up a provider using private phone dialogs", inputHint: "providers | accounts <provider> | <provider>", risk: "execute" as const, actions: ["providers", "accounts"] },
+			{ name: "login", description: "Sign in through a provider's real authentication flow", inputHint: "providers | accounts <provider> | <provider>", risk: "execute" as const, actions: ["providers", "accounts"] },
+			{ name: "logout", description: "Remove one exact stored provider credential", inputHint: "providers | accounts <provider> | <provider> <credentialId>", risk: "destructive" as const, actions: ["providers", "accounts"] },
+			{ name: "skills", description: "Search, install and update registry skills", inputHint: "search <query> | installed | install <spec...> --scope project|user | update [name...] --scope project|user", risk: "execute" as const, actions: ["search", "installed", "install", "update"] },
+		].map(({ actions, ...command }) => ({
+			...command, id: `builtin:${command.name}`, aliases: [], source: "builtin", available: true,
+			requiresIdle: true, localAction: command.name, subcommands: actions.map(name => ({ name })),
+		}));
+	}
+
+	isRead(name: string, raw: Args): boolean {
+		const args = parseOmputerAdminArgs(name, raw);
+		const action = args.action ?? (name === "settings" ? "list" : name === "skills" ? "installed" : "providers");
+		return name === "settings" ? action === "list" || action === "get"
+			: name === "skills" ? action === "search" || action === "installed"
+				: ["login", "logout", "setup"].includes(name) && (action === "providers" || action === "accounts");
+	}
+
+	async query(view: string, args: Json = {}): Promise<Json> {
+		if (!this.isRead(view, args)) fail("Administration mutations cannot run as queries");
+		return this.execute(view, args, () => {});
+	}
+
+	async execute(name: string, raw: Args, output: (text: string) => void): Promise<Json> {
+		const args = parseOmputerAdminArgs(name, raw);
+		if (!this.isRead(name, args) && (!this.ctx.isIdle() || this.session.isStreaming || this.session.isCompacting)) {
+			fail("Wait for the current turn before changing administration state", "session_busy");
+		}
+		let result: Json;
+		switch (name) {
+			case "settings": result = await this.settings(args); break;
+			case "login": case "setup": case "logout": result = await this.auth(name, args); break;
+			case "skills": result = await this.skills(args, output); break;
+			default: return fail("Unknown administration command");
+		}
+		output(JSON.stringify(result, null, 2));
+		return result;
+	}
+
+	private describe(setting: AnySetting): Json {
+		const base: Json = {
+			key: setting.id, type: setting.type, credential: setting.isCredential,
+			provenance: setting.provenance(this.session.settings), scopes: ["session", "saved"],
+			label: setting.ui?.label, description: setting.ui?.description,
+		};
+		if (setting.isCredential) return { ...base, redacted: true };
+		return { ...base, value: setting.get(this.session.settings), default: setting.default,
+			choices: setting.enumValues ?? (setting.definition.type === "array" ? setting.definition.items?.values : undefined) };
+	}
+
+	private async secret(title: string, placeholder?: string, signal?: AbortSignal): Promise<string> {
+		const ui = this.ctx.ui as SecretUI;
+		if (!ui.inputSecret) fail("Secure phone input is unavailable", "secure_input_unavailable");
+		let value: string | undefined;
+		try { value = await ui.inputSecret(title, placeholder, { signal, timeout: 600_000 }); }
+		catch (error) {
+			if (signal?.aborted || (error instanceof Error && "code" in error && error.code === "cancelled")) fail("Administration input cancelled", "cancelled");
+			fail("Secure input failed", "secure_input_failed");
+		}
+		if (value === undefined || signal?.aborted) fail("Administration input cancelled", "cancelled");
+		return value;
+	}
+
+	private async settings(args: Json): Promise<Json> {
+		const action = args.action ?? "list";
+		if (action === "list") {
+			fields(args, ["action"]);
+			return { settings: all().map(setting => this.describe(setting)) };
+		}
+		if (action === "get") {
+			fields(args, ["action", "key"]);
+			return { setting: this.describe(settingFor(args)) };
+		}
+		if (action !== "set" && action !== "reset") fail("Unknown settings action");
+		fields(args, action === "set" ? ["action", "key", "scope", "value"] : ["action", "key", "scope"]);
+		const setting = settingFor(args);
+		const selectedScope = scope(args);
+		let value: unknown;
+		if (action === "set") {
+			if (setting.isCredential) {
+				if (Object.hasOwn(args, "value")) fail("Credential values must use secure UI input");
+				const secret = await this.secret(`Set ${setting.id} (${selectedScope})`, `Enter ${setting.type} value`);
+				try { value = setting.parse(secret); setting.assertWritable(value); }
+				catch { fail("Invalid credential setting value"); }
+			} else {
+				if (!Object.hasOwn(args, "value")) fail("value is required");
+				value = args.value;
+				setting.assertWritable(value);
+			}
+		}
+		try {
+			if (selectedScope === "session") {
+				if (action === "reset") setting.clearOverride(this.session.settings);
+				else setting.override(this.session.settings, value);
+			} else {
+				if (action === "reset") setting.unset(this.session.settings);
+				else setting.set(this.session.settings, value);
+				await this.session.settings.flush();
+			}
+			if (setting.id === cfgDefaultThinkingLevel.id) {
+				this.session.setThinkingLevel(parseConfiguredThinkingLevel(cfgDefaultThinkingLevel.get(this.session.settings)), false);
+			}
+			await this.session.reconcileBuiltinTools({ refreshPrompt: false });
+			await this.session.refreshSkillsAndCommands();
+		} catch (error) {
+			if (setting.isCredential) fail("Credential setting could not be applied", "administration_failed");
+			throw error;
+		}
+		return { action, scope: selectedScope, setting: this.describe(setting) };
+	}
+
+	private async confirmPrivate(title: string, message: string, options?: ExtensionUIDialogOptions): Promise<boolean> {
+		const ui = this.ctx.ui as SecretUI;
+		if (!ui.confirmPrivate) fail("Private phone confirmation is unavailable", "secure_input_unavailable");
+		return ui.confirmPrivate(title, message, options);
+	}
+
+	private async auth(name: string, args: Json): Promise<Json> {
+		const action = args.action ?? "providers";
+		if (action === "providers") {
+			fields(args, ["action"]);
+			await this.session.modelRegistry.authStorage.credentials.reload();
+			const providers = await Promise.all(getOAuthProviders().map(async provider => ({
+				id: provider.id, name: provider.name, available: provider.available,
+				credentialProvider: provider.storeCredentialsAs ?? provider.id,
+				authenticated: this.session.modelRegistry.authStorage.keys.source(provider.storeCredentialsAs ?? provider.id) !== undefined,
+				accounts: await listLogoutAccounts(this.session.modelRegistry.authStorage, provider.id, this.session.sessionId),
+			})));
+			return { providers };
+		}
+		if (action === "accounts") {
+			fields(args, ["action", "providerId"]);
+			const providerId = text(args, "providerId");
