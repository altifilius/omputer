+export function createOmputerModes(session: AgentSession, ctx: OmputerModesContext) {
+	let active: { name: string; abort: AbortController } | undefined;
+	let lastResult: Json | undefined;
+	let disposed = false;
+	let headless: OmputerModeOwner | undefined;
