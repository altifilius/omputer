diff --git a/packages/coding-agent/src/modes/working-row-trailer.ts b/packages/coding-agent/src/modes/working-row-trailer.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/modes/working-row-trailer.ts
@@ -0,0 +1,21 @@
+import { visibleWidth } from "@oh-my-pi/pi-tui";
+import { truncateToWidth } from "@oh-my-pi/pi-tui/render/render-utils";
+
+/** Reserve throughput first, then complete resource groups, then the band title. */
+export function workingRowTrailer(
+	width: number,
+	rate: string | undefined,
+	resourceLabel: (width: number) => string | undefined,
+	title: string | undefined,
+): string | undefined {
+	if (width <= 0) return undefined;
+	let trailer = rate ? truncateToWidth(rate, width, "") : "";
+	const resources = resourceLabel(Math.max(0, width - visibleWidth(trailer) - (trailer ? 2 : 0)));
+	if (resources) trailer += `${trailer ? "  " : ""}${resources}`;
+	const titleWidth = width - visibleWidth(trailer) - (trailer ? 2 : 0);
+	if (title && titleWidth > 0) {
+		const fittedTitle = truncateToWidth(title, titleWidth, "");
+		if (fittedTitle) trailer += `${trailer ? "  " : ""}${fittedTitle}`;
+	}
+	return trailer || undefined;
+}
diff --git a/packages/coding-agent/src/plan-mode/headless-controller.ts b/packages/coding-agent/src/plan-mode/headless-controller.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/plan-mode/headless-controller.ts
@@ -0,0 +1,126 @@
+import type { Model } from "@oh-my-pi/pi-ai";
+import { modelsAreEqual } from "@oh-my-pi/pi-catalog/models";
+import type { ConfiguredThinkingLevel } from "@oh-my-pi/pi-tui/thinking";
+import { prompt } from "@oh-my-pi/pi-utils";
+import type { AgentSession } from "../session/agent-session";
+import { isMCPToolName } from "../tools/builtin-names";
+import planModeApprovedPrompt from "../prompts/system/plan-mode-approved.md" with { type: "text" };
+import type { ResolvedApprovedPlan } from "./approved-plan";
+import { autosaveApprovedPlan } from "./plan-autosave";
+import { resolvePlanModelTransition } from "./model-transition";
+import { cfgPlanEnabled } from "./settings";
+
+interface PlanSnapshot {
+	journalId: string;
+	enabled: string[];
+	mounted: string[];
+	registered: string[];
+	model?: Model;
+	thinkingLevel?: ConfiguredThinkingLevel;
+}
+
+/** RPC uses the same state, guards, tool partition, model policy and approval artifact as the TUI. */
+export class HeadlessPlanController {
+	#previous: PlanSnapshot | undefined;
+	constructor(readonly session: AgentSession) {}
+
+	async reconcile(): Promise<void> {
+		const manager = this.session.sessionManager;
+		const context = manager.buildSessionContext();
+		if (context.mode !== "plan") {
+			this.#previous = undefined;
+			this.session.setPlanModeState(undefined);
+			this.session.setPlanProposalHandler(null);
+			return;
+		}
+		const snapshot = manager.getBranch().findLast(entry => entry.type === "custom" && entry.customType === "omputer-plan-snapshot");
+		if (snapshot?.type === "custom") {
+			const saved = snapshot.data as PlanSnapshot;
+			const model = saved.model ? this.session.getAvailableModels().find(model => model.provider === saved.model?.provider && model.id === saved.model.id) : undefined;
+			this.#previous = { ...saved, model, journalId: manager.getSessionId() };
+		}
+		this.session.setPlanModeState({ enabled: true,
+			planFilePath: typeof context.modeData?.planFilePath === "string" ? context.modeData.planFilePath : "local://PLAN.md",
+			workflow: "parallel", reentry: true });
+		this.session.setPlanProposalHandler(title => this.session.preparePlanForReview(title));
+	}
+
+	async enter(): Promise<void> {
+		const session = this.session;
+		if (!cfgPlanEnabled.get(session.settings)) throw new Error("Plan mode is disabled (plan.enabled).");
+		if (session.getPlanModeState()?.enabled) return;
+		if (session.getGoalModeState()?.goal || session.getVibeModeState()?.enabled) throw new Error("Exit goal/vibe mode before planning.");
+		if (session.isBusyForSnapshot || session.queuedMessageCount > 0) throw new Error("Plan entry requires an idle session.");
+		const previous: PlanSnapshot = { journalId: session.sessionManager.getSessionId(),
+			enabled: session.getEnabledToolNames().filter(name => !isMCPToolName(name)),
+			mounted: session.getMountedXdevToolNames().filter(name => !isMCPToolName(name)),
+			registered: session.getAllToolNames(),
+			model: session.model, thinkingLevel: session.configuredThinkingLevel() };
+		const priorState = session.getPlanModeState();
+		const planFilePath = session.getPlanReferencePath() || "local://PLAN.md";
+		session.setPlanModeState({ enabled: true, planFilePath, workflow: "parallel", reentry: priorState !== undefined });
+		try {
+			const tools = session.getEnabledToolNames();
+			await session.setActiveToolsByName([...new Set([
+				...tools.filter(name => name !== "write"),
+				...(session.hasBuiltInTool("write") ? ["write"] : []),
+			])]);
+			const transition = resolvePlanModelTransition(session.model, session.resolveRoleModelWithThinking("plan"), false);
+			if (transition.kind === "thinking") session.setThinkingLevel(transition.thinkingLevel);
+			else if (transition.kind === "apply") await session.setModelTemporary(transition.model, transition.thinkingLevel);
+		} catch (error) {
+			session.setPlanModeState(priorState);
+			await session.restoreNonMCPToolPresentation(previous.enabled, previous.mounted, previous.registered);
+			if (previous.model) await session.setModelTemporary(previous.model, previous.thinkingLevel);
+			throw error;
+		}
+		this.#previous = previous;
+		session.setPlanProposalHandler(title => session.preparePlanForReview(title));
+		session.sessionManager.appendCustomEntry("omputer-plan-snapshot", { ...previous,
+			model: previous.model ? { provider: previous.model.provider, id: previous.model.id } : undefined });
+		session.sessionManager.appendModeChange("plan", { planFilePath });
+		await session.sessionManager.flush();
+	}
+
+	async cancel(): Promise<void> {
+		const session = this.session;
+		if (!session.getPlanModeState()?.enabled) throw new Error("Plan mode is not active.");
+		if (session.isBusyForSnapshot || session.queuedMessageCount > 0) throw new Error("Plan exit requires an idle session.");
+		const previous = this.#previous;
+		if (!previous || previous.journalId !== session.sessionManager.getSessionId()) throw new Error("Plan restoration snapshot is unavailable for this journal.");
+		const state = session.getPlanModeState();
+		const tools = session.getEnabledToolNames();
+		const mounted = session.getMountedXdevToolNames();
+		const model = session.model;
+		const thinking = session.configuredThinkingLevel();
+		session.setPlanModeState(undefined);
+		try {
+			await session.restoreNonMCPToolPresentation(previous.enabled, previous.mounted, previous.registered);
+			if (previous.model) {
+				if (modelsAreEqual(session.model, previous.model)) session.setThinkingLevel(previous.thinkingLevel);
+				else await session.setModelTemporary(previous.model, previous.thinkingLevel);
+			}
+		} catch (error) {
+			session.setPlanModeState(state);
+			await session.setActiveToolPresentation(tools, mounted);
+			if (model) await session.setModelTemporary(model, thinking);
+			throw error;
+		}
+		session.setPlanProposalHandler(null);
+		this.#previous = undefined;
+		session.sessionManager.appendModeChange("none");
+		await session.sessionManager.flush();
+	}
+
+	async approve(plan: ResolvedApprovedPlan): Promise<void> {
+		await autosaveApprovedPlan({ settings: this.session.settings, cwd: this.session.sessionManager.getCwd(),
+			title: plan.title, planContent: plan.planContent });
+		await this.cancel();
+		this.session.setPlanReferencePath(plan.planFilePath);
+		const tools = this.session.getEnabledToolNames();
+		if (!tools.includes("read")) await this.session.setActiveToolsByName([...tools, "read"]);
+		this.session.markPlanReferenceSent();
+		await this.session.prompt(prompt.render(planModeApprovedPrompt, { ...plan, contextPreserved: true }),
+			{ synthetic: true, runCommands: false, expandPromptTemplates: false, throwOnDrop: true });
+	}
+}
