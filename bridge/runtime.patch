+import { afterEach, beforeEach, expect, test, vi } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { Agent, agentPauseGate } from "@oh-my-pi/pi-agent-core";
+import { createMockModel, registerMockApi } from "@oh-my-pi/pi-ai/providers/mock";
+import { unregisterCustomApis } from "@oh-my-pi/pi-ai/api-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { bindOmputerModeOwner, createHeadlessModeOwner, createInteractiveModeOwner, createOmputerModes, type OmputerModesContext } from "@oh-my-pi/pi-coding-agent/session/omputer-modes";
+import { TtsrManager } from "@oh-my-pi/pi-coding-agent/export/ttsr";
+import * as loopCondition from "@oh-my-pi/pi-coding-agent/modes/loop-condition";
+
+let directory: string;
+let session: AgentSession;
+let auth: AuthStorage;
+let calls: number;
+const output: string[] = [];
+const rule = JSON.stringify({ name: "no-invented-api", description: "Do not invent APIs", condition: "invented-api", scope: ["text"], body: "Read the actual API before using it." });
+let response = "answer";
+let approve = false;
+let select: string | undefined;
+let input: string | undefined;
+let review = "";
+const MOCK_SOURCE = "omputer-modes-isolated-provider";
+
+beforeEach(async () => {
+	agentPauseGate.resume();
+	vi.useRealTimers();
+	registerMockApi(MOCK_SOURCE);
+	directory = await fs.mkdtemp(path.join(os.tmpdir(), "omputer-modes-"));
+	auth = await AuthStorage.create(":memory:"); auth.keys.setRuntime("mock", "test-key");
+	const registry = new ModelRegistry(auth, undefined, { ignoreLocalModelConfig: true });
+	calls = 0; output.length = 0; response = "answer"; approve = false; select = undefined; input = undefined; review = "";
+	const model = createMockModel({ handler: () => { calls++; return { content: [response] }; } });
+	session = new AgentSession({
+		agent: new Agent({ initialState: { model, systemPrompt: ["Test"], tools: [] }, convertToLlm, getApiKey: () => "test-key", streamFn: model.stream }),
+		sessionManager: SessionManager.create(directory, path.join(directory, "sessions")),
+		settings: Settings.isolated({ "compaction.enabled": false, "loop.mode": "prompt" }), modelRegistry: registry, ttsrManager: new TtsrManager(),
+	});
+});
+afterEach(async () => {
+	agentPauseGate.resume(); vi.useRealTimers();
+	try { await session.dispose(); }
+	finally { unregisterCustomApis(MOCK_SOURCE); vi.restoreAllMocks(); auth.close(); await fs.rm(directory, { recursive: true, force: true }); }
+});
+
+function controls(mode: OmputerModesContext["mode"] = "rpc") {
+	return createOmputerModes(session, { mode, ui: {
+		select: async () => select,
+		input: async () => input,
+		confirm: async (_title: string, message: string) => { review = message; return approve; },
+	} });
+}
+function nextYield(): Promise<void> {
+	const { promise, resolve } = Promise.withResolvers<void>();
+	const off = session.subscribe(event => { if (event.type === "agent_end" && event.isTerminal !== false) { off(); resolve(); } });
+	return promise;
+}
+function loopControls() {
+	let pending: (() => void) | undefined;
+	bindOmputerModeOwner(session, createHeadlessModeOwner(session, {
+		schedule(callback) { pending = callback; }, cancel() { pending = undefined; },
+	}));
+	return {
+		modes: controls(),
+		tick() { const callback = pending; pending = undefined; if (!callback) throw new Error("No continuation scheduled"); callback(); },
+		hasScheduled() { return pending !== undefined; },
+	};
+}
+
+test("all seven command metadata and busy-safe queries are real, without provider calls", async () => {
+	const modes = controls();
+	expect(modes.commands().map(item => item.name)).toEqual(["vibe", "loop", "queue", "tan", "omfg", "cleanse", "pause"]);
+	for (const view of ["modes", "vibe", "loop", "pause", "queue", "tan", "cleanse", "omfg"]) await modes.query(view);
+	expect(modes.isRead("loop", "status")).toBe(true);
+	expect(modes.isCancel("cleanse", "cancel")).toBe(true);
+	expect(calls).toBe(0);
+});
+
+test("queue calls the actual follow-up pipeline without expanding templates", async () => {
+	const modes = controls();
+	const followUp = vi.spyOn(session, "followUp");
+	await modes.execute("queue", "literal $1 /not-a-command", value => output.push(value));
+	expect(followUp).toHaveBeenCalledWith("literal $1 /not-a-command", undefined, { expandPromptTemplates: false, attribution: "user" });
+	expect(calls > 0 || session.queuedMessageCount > 0).toBe(true);
+});
+
+test("pause engages and releases the real global gate, with no waiting screen", async () => {
+	const modes = controls();
+	await modes.execute("pause", "on", value => output.push(value));
+	expect(agentPauseGate.paused).toBe(true);
+	let resumed = false;
+	const wait = agentPauseGate.waitUntilResumed().then(() => { resumed = true; });
+	await Promise.resolve(); expect(resumed).toBe(false);
+	expect(await modes.query("pause")).toMatchObject({ paused: true, scope: "process" });
+	await modes.execute("pause", "off", value => output.push(value)); await wait;
+	expect(resumed).toBe(true); expect(agentPauseGate.paused).toBe(false);
+});
+
+test("headless continuation spends the real limit budget and stops", async () => {
+	const { modes, tick } = loopControls();
+	const first = nextYield();
+	await modes.execute("loop", "1 repeat this", value => output.push(value));
+	await first; await session.waitForIdle();
+	const second = nextYield();
+	tick();
+	await second; await session.waitForIdle();
+	tick();
+	expect(calls).toBe(2);
+	expect(await modes.query("loop")).toMatchObject({ loop: { enabled: false, reason: "Loop limit reached." } });
+});
+
+test("condition halt never sends a second provider turn", async () => {
+	const { modes, tick } = loopControls();
+	const evaluate = vi.spyOn(loopCondition, "evaluateLoopCondition").mockResolvedValue({ kind: "halt", message: "Condition satisfied." });
+	const ended = nextYield();
+	await modes.execute("loop", "3 --until 'exit 0' repeat this", value => output.push(value));
+	await ended; await session.waitForIdle();
+	tick(); await Promise.resolve(); await Promise.resolve();
+	expect(evaluate).toHaveBeenCalledWith({ command: "exit 0", until: true }, expect.objectContaining({ cwd: directory, sessionId: session.sessionManager.getSessionId() }));
+	expect(calls).toBe(1);
+	expect(await modes.query("loop")).toMatchObject({ loop: { enabled: false } });
+});
+
+test("loop cancellation stops pending continuation without interrupting the current turn", async () => {
+	const { modes, hasScheduled } = loopControls();
+	const ended = nextYield();
+	await modes.execute("loop", "10 repeat this", value => output.push(value));
+	await modes.execute("loop", "cancel", value => output.push(value));
+	await ended; await session.waitForIdle();
+	expect(hasScheduled()).toBe(false);
+	expect(calls).toBe(1);
+	expect(await modes.query("loop")).toMatchObject({ loop: { enabled: false } });
+});
+
+test("TUI admission is delegated to the owning scheduler and never starts a second driver", async () => {
+	const submitted: string[] = [];
+	const host = { session, vibeModeEnabled: false, loopModeEnabled: false, loopModePaused: false,
+		handleVibeModeCommand: async () => { host.vibeModeEnabled = !host.vibeModeEnabled; return false; },
+		handleLoopCommand: async () => { host.loopModeEnabled = true; return "existing scheduler"; },
+		submitOmputerLoopPrompt: (prompt: string) => { submitted.push(prompt); },
+		pauseLoop: () => { host.loopModePaused = true; }, disableLoopMode: () => { host.loopModeEnabled = false; },
+	};
+	bindOmputerModeOwner(session, createInteractiveModeOwner(host));
+	const modes = controls("tui"); await modes.execute("loop", "2 existing scheduler", value => output.push(value));
+	expect(submitted).toEqual(["existing scheduler"]); expect(calls).toBe(0);
+	await modes.execute("loop", "pause", value => output.push(value)); expect(host.loopModePaused).toBe(true);
+});
+
+test("cleanse cancellation returns cancellation rather than success or unsupported", async () => {
+	const modes = controls();
