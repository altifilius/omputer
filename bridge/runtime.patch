new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/session/inherited-session-lease.ts
@@ -0,0 +1,90 @@
+import { dlopen, FFIType, ptr } from "bun:ffi";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { FileLockHandle } from "@oh-my-pi/pi-utils/file-lock";
+import { openCloexecSync } from "@oh-my-pi/pi-utils/fs-open";
+
+const fdText = process.env.OMPUTER_SESSION_LEASE_FD;
+const journalId = process.env.OMPUTER_SESSION_LEASE_ID;
+delete process.env.OMPUTER_SESSION_LEASE_FD;
+delete process.env.OMPUTER_SESSION_LEASE_ID;
+let inherited: { fd: number; name: Buffer; journalId: string } | undefined;
+let accepted: { journalId: string; source: string } | undefined;
+
+// Adopt during module evaluation, before startup can launch any descendants.
+// Linux dup3(oldfd, newfd, O_CLOEXEC) is fixed-arity; unlike variadic fcntl,
+// its documented ABI is safe to call through Bun FFI. Reserve newfd first so
+// duplication can never overwrite a descriptor owned by Bun or an extension.
+if (fdText !== undefined || journalId !== undefined) {
+	if (process.platform !== "linux" || !fdText || !/^[0-9]+$/.test(fdText)
+		|| !journalId || !/^[A-Za-z0-9_-]{1,128}$/.test(journalId)) {
+		throw new Error("Invalid advertised session lease handoff");
+	}
+	const fd = Number(fdText);
+	if (!Number.isSafeInteger(fd) || fd < 3 || fd > 0x7fffffff) throw new Error("Invalid inherited session lease descriptor");
+	const libc = dlopen("libc.so.6", {
+		getsockname: { args: [FFIType.i32, FFIType.ptr, FFIType.ptr], returns: FFIType.i32 },
+		getsockopt: { args: [FFIType.i32, FFIType.i32, FFIType.i32, FFIType.ptr, FFIType.ptr], returns: FFIType.i32 },
+		dup3: { args: [FFIType.i32, FFIType.i32, FFIType.i32], returns: FFIType.i32 },
+	});
+	let owned = -1;
+	try {
+		for (const [option, expected] of [[39, 1], [3, 2], [38, 0]] as const) {
+			const value = new Int32Array(1);
+			const size = new Uint32Array([4]);
+			if (libc.symbols.getsockopt(fd, 1, option, ptr(value), ptr(size)) !== 0 || size[0] !== 4 || value[0] !== expected) {
+				throw new Error("Inherited session lease is not an AF_UNIX SOCK_DGRAM socket");
+			}
+		}
+		const address = Buffer.alloc(110);
+		const size = new Uint32Array([address.length]);
+		if (libc.symbols.getsockname(fd, ptr(address), ptr(size)) !== 0 || size[0]! > address.length
+			|| address.readUInt16LE(0) !== 1 || address[2] !== 0) {
+			throw new Error("Inherited session lease is not an abstract Unix socket");
+		}
+		const name = Buffer.from(address.subarray(3, size[0]));
+		if (!/^omp-file-lock-[0-9a-f]{32}$/.test(name.toString("ascii")) || name.length !== 46) {
+			throw new Error("Inherited session lease has an invalid abstract name");
+		}
+		owned = openCloexecSync("/dev/null", fs.constants.O_RDONLY);
+		if (owned === fd || libc.symbols.dup3(fd, owned, 0x80000) !== owned) throw new Error("Cannot protect inherited session lease from descendants");
+		fs.closeSync(fd);
+		inherited = { fd: owned, name, journalId };
+		owned = -1;
+	} finally {
+		if (owned >= 0) fs.closeSync(owned);
+		libc.close();
+	}
+}
+
+/** Validate against FileLock's exact normalized key and the loaded journal. */
+export function claimInheritedSessionLease(sessionId: string, source: string, lockPath: string, onDiskId: string | undefined): FileLockHandle | undefined {
+	if (!inherited) return undefined;
+	const key = `${path.resolve(lockPath)}.lock`;
+	const high = Bun.hash.xxHash64(key, 0x4f4d502d4c4f434bn).toString(16).padStart(16, "0");
+	const low = Bun.hash.xxHash64(key, 0x50492d46494c454cn).toString(16).padStart(16, "0");
+	if (sessionId !== inherited.journalId || onDiskId !== sessionId
+		|| !inherited.name.equals(Buffer.from(`omp-file-lock-${high}${low}`))) {
+		throw new Error("Inherited session lease does not match the journal's native identity");
+	}
+	const stat = fs.lstatSync(source);
+	if (!stat.isFile() || fs.realpathSync(source) !== source) throw new Error("Inherited session source must be a canonical regular file");
+	const fd = inherited.fd;
+	inherited = undefined;
+	accepted = { journalId: sessionId, source };
+	let released = false;
+	return { release() { if (!released) { released = true; fs.closeSync(fd); } } };
+}
+/** True only for the explicitly advertised native handoff, including an early writer claim. */
+export function hasInheritedSessionLeaseHandoff(): boolean {
+	return inherited !== undefined || accepted !== undefined;
+}
+
+
+export function acceptedSessionLeaseHandoff(sessionId: string, source: string | undefined): { journalId: string; source: string } | undefined {
+	if (inherited) throw new Error("Advertised inherited session lease was not claimed before readiness");
+	if (accepted && (accepted.journalId !== sessionId || accepted.source !== source)) {
+		throw new Error("Native startup changed the inherited session binding before readiness");
+	}
+	return accepted;
+}
